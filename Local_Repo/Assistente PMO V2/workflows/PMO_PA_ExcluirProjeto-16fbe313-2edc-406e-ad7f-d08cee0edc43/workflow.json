{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pmo_sharedsharepointonline_6e373"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "title": "Projeto",
                  "description": "Nome do projeto ou ProjectID",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "type": "string",
                  "title": "Motivo",
                  "description": "Motivo da remocao logica",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "type": "string",
                  "title": "DeletedByUPN",
                  "description": "UPN do usuario solicitante",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "text",
                "text_1"
              ]
            }
          }
        }
      },
      "actions": {
        "Compose_ProjectInput": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerBody()?[\u0027text\u0027], \u0027\u0027))"
        },
        "Get_Projeto_By_ProjectID": {
          "runAfter": {
            "Compose_ProjectInput": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$filter": "ProjectID eq \u0027@{replace(outputs(\u0027Compose_ProjectInput\u0027),\u0027\u0027\u0027\u0027,\u0027\u0027\u0027\u0027\u0027\u0027)}\u0027 and Ativo eq 1 and Deleted eq 0",
              "$top": 2
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Get_Projeto_By_Name": {
          "runAfter": {
            "Get_Projeto_By_ProjectID": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$filter": "NomeProjeto eq \u0027@{replace(outputs(\u0027Compose_ProjectInput\u0027),\u0027\u0027\u0027\u0027,\u0027\u0027\u0027\u0027\u0027\u0027)}\u0027 and Ativo eq 1 and Deleted eq 0",
              "$top": 2
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Compose_TargetRows": {
          "runAfter": {
            "Get_Projeto_By_Name": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(length(body(\u0027Get_Projeto_By_ProjectID\u0027)?[\u0027value\u0027]), 0), body(\u0027Get_Projeto_By_ProjectID\u0027)?[\u0027value\u0027], body(\u0027Get_Projeto_By_Name\u0027)?[\u0027value\u0027])"
        },
        "Condition_Target_Found": {
          "runAfter": {
            "Compose_TargetRows": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(outputs(\u0027Compose_TargetRows\u0027))",
              0
            ]
          },
          "actions": {
            "Condition_Target_Unique": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "equals": [
                  "@length(outputs(\u0027Compose_TargetRows\u0027))",
                  1
                ]
              },
              "actions": {
                "Update_Projeto_Soft_Delete": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                      "table": "Projetos",
                      "id": "@outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027ID\u0027]",
                      "item/Title": "@coalesce(outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027Title\u0027], outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027NomeProjeto\u0027])",
                      "item/ProjectID": "@outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027ProjectID\u0027]",
                      "item/NomeProjeto": "@outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027NomeProjeto\u0027]",
                      "item/PM/Claims": "@coalesce(outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027PM\u0027]?[\u0027Claims\u0027], concat(\u0027i:0#.f|membership|\u0027, coalesce(outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027PM\u0027]?[\u0027Email\u0027], \u0027mbenicios@minsait.com\u0027)))",
                      "item/StatusRAG/Value": "@coalesce(outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027StatusRAG\u0027]?[\u0027Value\u0027], outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027StatusRAG\u0027], \u0027Verde\u0027)",
                      "item/Percentual": "@coalesce(outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027Percentual\u0027], 0)",
                      "item/Ativo": false,
                      "item/Deleted": true,
                      "item/DeletedAt": "@utcNow()",
                      "item/DeletedReason": "@triggerBody()?[\u0027text_1\u0027]",
                      "item/DeletedByUPN": "@coalesce(triggerBody()?[\u0027text_2\u0027], \u0027mbenicios@minsait.com\u0027)"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "authentication": "@parameters(\u0027$authentication\u0027)"
                  }
                },
                "Response_OK": {
                  "runAfter": {
                    "Update_Projeto_Soft_Delete": [
                      "Succeeded"
                    ]
                  },
                  "type": "Response",
                  "kind": "Skills",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "message": "@{concat(\u0027Projeto removido do portfolio ativo. ProjectID: \u0027, outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027ProjectID\u0027], \u0027. Nome: \u0027, outputs(\u0027Compose_TargetRows\u0027)?[0]?[\u0027NomeProjeto\u0027], \u0027. Motivo: \u0027, triggerBody()?[\u0027text_1\u0027], \u0027.\u0027)}"
                    },
                    "schema": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "title": "message"
                        }
                      }
                    }
                  }
                },
                "Response_Error_Update": {
                  "runAfter": {
                    "Update_Projeto_Soft_Delete": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "Response",
                  "kind": "Skills",
                  "inputs": {
                    "statusCode": 500,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "message": "Erro ao remover projeto no SharePoint. Codigo: SP_PROJECT_SOFT_DELETE_FAILED."
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Response_Ambiguous": {
                    "type": "Response",
                    "kind": "Skills",
                    "inputs": {
                      "statusCode": 409,
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "message": "Mais de um projeto ativo foi encontrado. Informe o ProjectID para remover com seguranca. Codigo: PROJECT_AMBIGUOUS."
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Response_Project_Not_Found": {
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 404,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "message": "Projeto ativo nao encontrado. Codigo: PROJECT_NOT_FOUND."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}