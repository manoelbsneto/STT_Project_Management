                                                           "select":  "@concat(\u0027- \u0027, item()?[\u0027DecisionID\u0027], \u0027 | \u0027, item()?[\u0027ProjectID\u0027], \u0027 | \u0027, coalesce(item()?[\u0027Descricao\u0027], \u0027-\u0027))"
