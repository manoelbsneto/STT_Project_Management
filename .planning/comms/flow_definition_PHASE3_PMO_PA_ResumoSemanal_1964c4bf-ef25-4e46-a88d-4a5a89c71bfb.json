                    "Filter_Projetos_Sem_Update":  {
                                                       "runAfter":  {
                                                                        "Filter_Vermelhos":  [
                                                                                                 "Succeeded"
                                                                                             ]
                                                                    },
                                                       "type":  "Query",
                                                       "inputs":  {
                                                                      "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                                      "where":  "@lessOrEquals(coalesce(item()?[\u0027UltimaAtualizacao\u0027], \u00271900-01-01T00:00:00Z\u0027), addDays(utcNow(), -1))"
                                                                  }
                                                   },
                    "Select_Projetos_Sem_Update":  {
                                                       "runAfter":  {
                                                                        "Filter_Projetos_Sem_Update":  [
                                                                                                           "Succeeded"
