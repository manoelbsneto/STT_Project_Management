                                                      "inputs":  {
                                                                     "parameters":  {
                                                                                        "poster":  "Flow bot",
                                                                                        "body/messageBody":  "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(\u0027{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"emphasis\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Resumo Semanal do Portfolio\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${Periodo}\",\"isSubtle\":true,\"spacing\":\"None\",\"wrap\":true}]},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Projetos ativos:\",\"value\":\"${TotalProjetos}\"},{\"title\":\"Verdes:\",\"value\":\"${Verdes}\"},{\"title\":\"Amarelos:\",\"value\":\"${Amarelos}\"},{\"title\":\"Vermelhos:\",\"value\":\"${Vermelhos}\"},{\"title\":\"Projetos sem update:\",\"value\":\"${SemUpdateCount}\"},{\"title\":\"Status registrados:\",\"value\":\"${StatusSemanaCount}\"},{\"title\":\"Decisoes na semana:\",\"value\":\"${DecisoesSemanaCount}\"},{\"title\":\"Projetos com alvo vencido:\",\"value\":\"${AtrasadosCount}\"}]},{\"type\":\"TextBlock\",\"text\":\"Projetos sem atualizacao\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${ProjetosSemUpdate}\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"Projetos com data alvo vencida\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${ProjetosAtrasados}\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"Decisoes recentes\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${DecisoesSemana}\",\"wrap\":true}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"Abrir hub PMO\",\"url\":\"${HubUrl}\"}]}\u0027, \u0027${Periodo}\u0027, concat(formatDateTime(addDays(utcNow(), -7), \u0027dd/MM/yyyy\u0027), \u0027 - \u0027, formatDateTime(utcNow(), \u0027dd/MM/yyyy\u0027))), \u0027${TotalProjetos}\u0027, string(outputs(\u0027Count_Total\u0027))), \u0027${Verdes}\u0027, string(outputs(\u0027Count_Verdes\u0027))), \u0027${Amarelos}\u0027, string(outputs(\u0027Count_Amarelos\u0027))), \u0027${Vermelhos}\u0027, string(outputs(\u0027Count_Vermelhos\u0027))), \u0027${SemUpdateCount}\u0027, string(outputs(\u0027Count_Sem_Update\u0027))), \u0027${StatusSemanaCount}\u0027, string(outputs(\u0027Count_Status_Semana\u0027))), \u0027${DecisoesSemanaCount}\u0027, string(outputs(\u0027Count_Decisoes_Semana\u0027))), \u0027${AtrasadosCount}\u0027, string(outputs(\u0027Count_Atrasados\u0027))), \u0027${ProjetosSemUpdate}\u0027, outputs(\u0027Compose_Projetos_Sem_Update\u0027)), \u0027${ProjetosAtrasados}\u0027, outputs(\u0027Compose_Projetos_Atrasados\u0027)), \u0027${DecisoesSemana}\u0027, outputs(\u0027Compose_Decisoes_Semana\u0027)), \u0027${HubUrl}\u0027, \u0027https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital/Lists/Projetos/AllItems.aspx\u0027)",
                                                                                        "body/recipient/channelId":  "19:4c8fe80b169f4e698c9b1b15d1868691@thread.tacv2",
                                                                                        "location":  "Channel",
                                                                                        "body/recipient/groupId":  "96c5b0c4-46cc-46cd-8695-50451db74994"
                                                                                    },
                                                                     "host":  {
