                                                                    },
                                                       "type":  "Select",
                                                       "inputs":  {
                                                                      "from":  "@body(\u0027Filter_Projetos_Sem_Update\u0027)",
                                                                      "select":  "@concat(\u0027- \u0027, item()?[\u0027ProjectID\u0027], \u0027 | \u0027, coalesce(item()?[\u0027NomeProjeto\u0027], item()?[\u0027Title\u0027], \u0027-\u0027), \u0027 | Ultima: \u0027, coalesce(string(item()?[\u0027UltimaAtualizacao\u0027]), \u0027-\u0027))"
                                                                  }
                                                   },
                    "Compose_Projetos_Sem_Update":  {
