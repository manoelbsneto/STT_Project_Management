{
  "timestamp": "2026-05-10T20:06:10.5583186-03:00",
  "status": "BUILD_ONLY",
  "displayName": "PMO_PA_PedirDecisaoBot",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "Copilot_Request": {
        "type": "Request",
        "kind": "Skills",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "impacto": {
                "type": "string",
                "description": "Impacto"
              },
              "solicitante": {
                "type": "string",
                "description": "UPN do solicitante"
              },
              "descricao": {
                "type": "string",
                "description": "Descricao da decisao"
              },
              "projectName": {
                "type": "string",
                "description": "Nome do projeto"
              },
              "aprovador": {
                "type": "string",
                "description": "UPN do aprovador"
              },
              "prazo": {
                "type": "string",
                "description": "Prazo"
              }
            },
            "required": [
              "projectName",
              "descricao",
              "impacto",
              "prazo",
              "aprovador"
            ]
          }
        }
      }
    },
    "actions": {
      "Compose_ProjectName": {
        "type": "Compose",
        "inputs": "@trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))",
        "runAfter": {}
      },
      "Compose_Solicitante": {
        "type": "Compose",
        "inputs": "@coalesce(triggerBody()?['solicitante'], triggerBody()?['aprovador'])",
        "runAfter": {
          "Compose_DecisionID": [
            "Succeeded"
          ]
        }
      },
      "Map_Impacto": {
        "type": "Compose",
        "inputs": "@if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'cr'), 'Critico', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'a'), 'Alto', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'm'), 'Medio', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'b'), 'Baixo', 'Medio'))))",
        "runAfter": {
          "Get_Projeto": [
            "Succeeded"
          ]
        }
      },
      "Condition_Projeto_Encontrado": {
        "type": "If",
        "expression": {
          "greater": [
            "@length(body('Get_Projeto')?['value'])",
            0
          ]
        },
        "actions": {
          "Create_Decisao_SharePoint": {
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "item/StatusDecisao/Value": "Pendente",
                "item/Descricao": "@triggerBody()?['descricao']",
                "item/ProjectID": "@body('Get_Projeto')?['value']?[0]?['ProjectID']",
                "table": "Decisoes do Board",
                "item/ApproverUPN": "@triggerBody()?['aprovador']",
                "item/DecisionID": "@outputs('Compose_DecisionID')",
                "item/Impacto/Value": "@outputs('Map_Impacto')",
                "item/Solicitante/Claims": "@concat('i:0#.f|membership|', outputs('Compose_Solicitante'))",
                "item/Aprovador/Claims": "@concat('i:0#.f|membership|', triggerBody()?['aprovador'])",
                "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                "item/ResponseSource/Value": "CopilotStudio",
                "item/Deleted": false,
                "item/CardVersion": "1.0",
                "item/Prazo": "@outputs('Compose_Prazo')",
                "item/Title": "@outputs('Compose_DecisionID')"
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "operationId": "PostItem",
                "connectionName": "shared_sharepointonline"
              },
              "authentication": "@parameters('$authentication')"
            },
            "runAfter": {}
          },
          "Response_OK": {
            "type": "Response",
            "kind": "Skills",
            "inputs": {
              "statusCode": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "result": "@{concat('Decisao ', outputs('Compose_DecisionID'), ' registrada para projeto ', outputs('Compose_ProjectName'), '.')}"
              }
            },
            "runAfter": {
              "Create_Decisao_SharePoint": [
                "Succeeded"
              ]
            }
          },
          "Response_Error_Write": {
            "type": "Response",
            "kind": "Skills",
            "inputs": {
              "statusCode": 500,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "result": "Erro ao registrar decisao no SharePoint. Codigo: SP_WRITE_FAILED."
              }
            },
            "runAfter": {
              "Create_Decisao_SharePoint": [
                "Failed",
                "TimedOut"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Response_Project_Not_Found": {
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "result": "Projeto nao encontrado. Codigo: PROJECT_NOT_FOUND."
                }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Compose_Solicitante": [
            "Succeeded"
          ]
        }
      },
      "Compose_Prazo": {
        "type": "Compose",
        "inputs": "@if(or(empty(triggerBody()?['prazo']), not(contains(string(triggerBody()?['prazo']), '/'))), triggerBody()?['prazo'], concat(last(split(string(triggerBody()?['prazo']), '/')), '-', if(equals(length(first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), 1), concat('0', first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), '-', if(equals(length(first(split(string(triggerBody()?['prazo']), '/'))), 1), concat('0', first(split(string(triggerBody()?['prazo']), '/'))), first(split(string(triggerBody()?['prazo']), '/')))))",
        "runAfter": {
          "Map_Impacto": [
            "Succeeded"
          ]
        }
      },
      "Get_Projeto": {
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "$top": 1,
            "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
            "$filter": "NomeProjeto eq '@{replace(outputs('Compose_ProjectName'),'''','''''')}' and Ativo eq 1 and Deleted eq 0",
            "table": "Projetos"
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "operationId": "GetItems",
            "connectionName": "shared_sharepointonline"
          },
          "authentication": "@parameters('$authentication')"
        },
        "runAfter": {
          "Compose_ProjectName": [
            "Succeeded"
          ]
        }
      },
      "Compose_DecisionID": {
        "type": "Compose",
        "inputs": "@concat('DEC-', toUpper(substring(guid(), 0, 8)))",
        "runAfter": {
          "Compose_Prazo": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "triggerType": "Request/Skills",
  "connectors": [
    "shared_sharepointonline"
  ],
  "standardOnly": true
}
