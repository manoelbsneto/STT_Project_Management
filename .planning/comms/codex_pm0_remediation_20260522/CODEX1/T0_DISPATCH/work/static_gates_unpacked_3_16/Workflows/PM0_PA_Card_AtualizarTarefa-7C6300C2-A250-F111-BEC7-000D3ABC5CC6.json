{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "44f187cde7f54f208cf22bac4e533816",
        "connectionReferenceLogicalName": "cat_DataverseIndexerSharePoint",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "displayName": "SharePoint",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1769/1.0.1769.4361/sharepointonline/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      },
      "shared_planner": {
        "connectionName": "6b763b98729c4d99a7a8df4033d381af",
        "connectionReferenceLogicalName": "pmo_sharedplanner_87b5f",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_planner",
        "displayName": "Planner",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1808/1.0.1808.4692/planner/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "planner",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Action"
                },
                "spItemId": {
                  "type": "string",
                  "description": "SharePoint item ID"
                },
                "taskId": {
                  "type": "string",
                  "description": "SharePoint item ID from card"
                },
                "status": {
                  "type": "string",
                  "description": "Status"
                },
                "taskStatus": {
                  "type": "string",
                  "description": "Status from card"
                },
                "comments": {
                  "type": "string",
                  "description": "Comments"
                },
                "horasRealizadas": {
                  "type": "number",
                  "description": "Completed hours"
                },
                "responsavel": {
                  "type": "string",
                  "description": "Task responsible"
                },
                "dataFim": {
                  "type": "string",
                  "description": "Task due date"
                },
                "prioridade": {
                  "type": "string",
                  "description": "Task priority"
                }
              },
              "required": [
                "action"
              ]
            }
          }
        }
      },
      "actions": {
        "Update_Planner_Task": {
          "runAfter": {
            "Determine_Bucket_and_Percent": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "@body('Get_SharePoint_Item')?['PlannerTaskId']",
              "body/percentComplete": "@outputs('Determine_Bucket_and_Percent')?['percentComplete']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_planner",
              "connectionName": "shared_planner",
              "operationId": "UpdateTask_V2"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Determine_Bucket_and_Percent": {
          "runAfter": {
            "Get_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(coalesce(triggerBody()?['status'],triggerBody()?['taskStatus']), 'Em Andamento'), json('{\"bucketId\":\"ugZSNxsYW0WWCJ5Dtx0-l5cALVXG\",\"percentComplete\":50}'), if(equals(coalesce(triggerBody()?['status'],triggerBody()?['taskStatus']), 'Testes'), json('{\"bucketId\":\"7QYPufh54kum7MP4KUzzAZcAL6Ik\",\"percentComplete\":50}'), if(equals(coalesce(triggerBody()?['status'],triggerBody()?['taskStatus']), 'Piloto e Implantacao'), json('{\"bucketId\":\"4YAXH7iU9E-6jZE2P1DbG5cAMAzH\",\"percentComplete\":50}'), if(equals(coalesce(triggerBody()?['status'],triggerBody()?['taskStatus']), 'Concluido'), json('{\"bucketId\":\"F2WYUsnXeEue5qlwQuu3GJcAN1Ns\",\"percentComplete\":100}'), if(equals(coalesce(triggerBody()?['status'],triggerBody()?['taskStatus']), 'Cancelado'), json('{\"bucketId\":\"90TcFTFup0CjiHIdzY4gG5cALWKL\",\"percentComplete\":100}'), json('{\"bucketId\":\"HmzyGOgC4k6uOPm_cwG3zZcAGiAG\",\"percentComplete\":0}'))))))"
        },
        "Update_SharePoint_Item": {
          "runAfter": {
            "Update_Planner_Task": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/Status/Value": "@coalesce(triggerBody()?['status'],triggerBody()?['taskStatus'])",
              "item/Title": "@body('Get_SharePoint_Item')?['Title']",
              "id": "@coalesce(triggerBody()?['spItemId'],triggerBody()?['taskId'])",
              "item/PlannerSyncStatus/Value": "OK",
              "table": "Tarefas",
              "item/ProjectID": "@body('Get_SharePoint_Item')?['ProjectID']",
              "item/PlannerBucketId": "@outputs('Determine_Bucket_and_Percent')?['bucketId']",
              "item/PlannerLastSyncAt": "@utcNow()",
              "item/PlannerSyncError": "",
              "item/HorasRealizadas": "@if(empty(triggerBody()?['horasRealizadas']), coalesce(body('Get_SharePoint_Item')?['HorasRealizadas'], 0), triggerBody()?['horasRealizadas'])",
              "item/Responsavel": "@if(empty(triggerBody()?['responsavel']), coalesce(body('Get_SharePoint_Item')?['Responsavel'], ''), triggerBody()?['responsavel'])",
              "item/DataFim": "@if(empty(triggerBody()?['dataFim']), body('Get_SharePoint_Item')?['DataFim'], triggerBody()?['dataFim'])",
              "item/Prioridade/Value": "@if(empty(triggerBody()?['prioridade']), coalesce(body('Get_SharePoint_Item')?['Prioridade']?['Value'], body('Get_SharePoint_Item')?['Prioridade'], 'Media'), if(startsWith(toLower(triggerBody()?['prioridade']), 'cr'), 'Critica', if(startsWith(toLower(triggerBody()?['prioridade']), 'al'), 'Alta', if(startsWith(toLower(triggerBody()?['prioridade']), 'ba'), 'Baixa', 'Media'))))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Respond_Success": {
          "runAfter": {
            "Update_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "result": "@{concat('Tarefa ', coalesce(triggerBody()?['taskId'], triggerBody()?['spItemId']), ' atualizada para ', coalesce(triggerBody()?['status'], triggerBody()?['taskStatus'], string(body('Update_SharePoint_Item')?['Status']?['Value']), ''), '. Responsavel: ', if(empty(triggerBody()?['responsavel']), 'mantido', triggerBody()?['responsavel']), '. Prazo: ', if(empty(triggerBody()?['dataFim']), 'mantido', triggerBody()?['dataFim']), '. Item SP: ', string(body('Update_SharePoint_Item')?['ID']), '. Planner percent: ', string(outputs('Determine_Bucket_and_Percent')?['percentComplete']), '.')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Get_SharePoint_Item": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "table": "Tarefas",
              "id": "@coalesce(triggerBody()?['spItemId'],triggerBody()?['taskId'])",
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}