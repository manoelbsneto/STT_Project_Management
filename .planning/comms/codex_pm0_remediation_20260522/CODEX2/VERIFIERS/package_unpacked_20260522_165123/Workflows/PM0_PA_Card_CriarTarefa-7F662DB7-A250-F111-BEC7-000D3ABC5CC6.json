{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "44f187cde7f54f208cf22bac4e533816",
        "connectionReferenceLogicalName": "cat_DataverseIndexerSharePoint",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "displayName": "SharePoint",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1769/1.0.1769.4361/sharepointonline/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      },
      "shared_planner": {
        "connectionName": "6b763b98729c4d99a7a8df4033d381af",
        "connectionReferenceLogicalName": "pmo_sharedplanner_87b5f",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_planner",
        "displayName": "Planner",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1808/1.0.1808.4692/planner/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "planner",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "dueDate": {
                  "type": "string",
                  "description": "Due date from card"
                },
                "action": {
                  "type": "string",
                  "description": "Action"
                },
                "taskTitle": {
                  "type": "string",
                  "description": "Task title from card"
                },
                "projectId": {
                  "type": "string",
                  "description": "Project ID"
                },
                "endDate": {
                  "type": "string",
                  "description": "End date"
                },
                "startDate": {
                  "type": "string",
                  "description": "Start date"
                },
                "bucket": {
                  "type": "string",
                  "description": "Bucket"
                },
                "title": {
                  "type": "string",
                  "description": "Task title"
                },
                "plannerBucketName": {
                  "type": "string",
                  "description": "Bucket from card"
                },
                "responsavel": {
                  "type": "string",
                  "description": "Task responsible"
                },
                "prazo": {
                  "type": "string",
                  "description": "Task due date"
                },
                "horas": {
                  "type": "number",
                  "description": "Estimated hours"
                },
                "prioridade": {
                  "type": "string",
                  "description": "Task priority"
                }
              },
              "required": [
                "projectId",
                "action"
              ]
            }
          }
        }
      },
      "actions": {
        "Create_Planner_Task": {
          "runAfter": {
            "Get_Project_By_Name": [
              "Succeeded"
            ],
            "Determine_Bucket_and_Status": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "body/groupId": "96c5b0c4-46cc-46cd-8695-50451db74994",
              "body/planId": "-1kBj1PLv0qQM-R4PwkqbpcABv_P",
              "body/title": "@coalesce(triggerBody()?[\u0027title\u0027],triggerBody()?[\u0027taskTitle\u0027])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_planner",
              "connectionName": "shared_planner",
              "operationId": "CreateTask_V3"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
              "type": "Raw"
            }
          }
        },
        "Determine_Bucket_and_Status": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(equals(coalesce(triggerBody()?[\u0027bucket\u0027],triggerBody()?[\u0027plannerBucketName\u0027]), \u0027Piloto e Implantacao\u0027), json(\u0027{\u0022bucketId\u0022:\u00224YAXH7iU9E-6jZE2P1DbG5cAMAzH\u0022,\u0022status\u0022:\u0022Piloto e Implantacao\u0022}\u0027), if(equals(coalesce(triggerBody()?[\u0027bucket\u0027],triggerBody()?[\u0027plannerBucketName\u0027]), \u0027Testes\u0027), json(\u0027{\u0022bucketId\u0022:\u00227QYPufh54kum7MP4KUzzAZcAL6Ik\u0022,\u0022status\u0022:\u0022Testes\u0022}\u0027), if(equals(coalesce(triggerBody()?[\u0027bucket\u0027],triggerBody()?[\u0027plannerBucketName\u0027]), \u0027Cancelado\u0027), json(\u0027{\u0022bucketId\u0022:\u002290TcFTFup0CjiHIdzY4gG5cALWKL\u0022,\u0022status\u0022:\u0022Cancelado\u0022}\u0027), if(equals(coalesce(triggerBody()?[\u0027bucket\u0027],triggerBody()?[\u0027plannerBucketName\u0027]), \u0027Concluido\u0027), json(\u0027{\u0022bucketId\u0022:\u0022F2WYUsnXeEue5qlwQuu3GJcAN1Ns\u0022,\u0022status\u0022:\u0022Concluido\u0022}\u0027), if(equals(coalesce(triggerBody()?[\u0027bucket\u0027],triggerBody()?[\u0027plannerBucketName\u0027]), \u0027Em Andamento\u0027), json(\u0027{\u0022bucketId\u0022:\u0022ugZSNxsYW0WWCJ5Dtx0-l5cALVXG\u0022,\u0022status\u0022:\u0022Em Andamento\u0022}\u0027), json(\u0027{\u0022bucketId\u0022:\u0022HmzyGOgC4k6uOPm_cwG3zZcAGiAG\u0022,\u0022status\u0022:\u0022Pendente\u0022}\u0027))))))"
        },
        "Get_Project_By_Name": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$filter": "ProjectID eq '@{replace(triggerBody()?['projectId'],'''','''''')}' or Title eq '@{replace(triggerBody()?['projectId'],'''','''''')}' or NomeProjeto eq '@{replace(triggerBody()?['projectId'],'''','''''')}'",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Create_SharePoint_Item": {
          "runAfter": {
            "Create_Planner_Task": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/PlannerLastSyncAt": "@utcNow()",
              "item/Title": "@coalesce(triggerBody()?[\u0027title\u0027],triggerBody()?[\u0027taskTitle\u0027])",
              "item/PlannerSyncStatus/Value": "OK",
              "table": "Tarefas",
              "item/ProjectID": "@coalesce(body('Get_Project_By_Name')?['value']?[0]?['ProjectID'], triggerBody()?['projectId'])",
              "item/PlannerBucketId": "@outputs(\u0027Determine_Bucket_and_Status\u0027)?[\u0027bucketId\u0027]",
              "item/PlannerTaskId": "@body(\u0027Create_Planner_Task\u0027)?[\u0027id\u0027]",
              "item/Status/Value": "@outputs(\u0027Determine_Bucket_and_Status\u0027)?[\u0027status\u0027]",
              "item/PlannerSyncError": "",
              "item/Responsavel": "@coalesce(triggerBody()?['responsavel'], '')",
              "item/DataFim": "@coalesce(triggerBody()?['prazo'], triggerBody()?['dueDate'], triggerBody()?['endDate'])",
              "item/HorasEstimadas": "@coalesce(triggerBody()?['horas'], 0)",
              "item/Prioridade/Value": "@if(empty(triggerBody()?['prioridade']), 'Media', if(startsWith(toLower(triggerBody()?['prioridade']), 'cr'), 'Critica', if(startsWith(toLower(triggerBody()?['prioridade']), 'al'), 'Alta', if(startsWith(toLower(triggerBody()?['prioridade']), 'ba'), 'Baixa', 'Media'))))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
              "type": "Raw"
            }
          }
        },
        "Respond_Success": {
          "runAfter": {
            "Create_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "result": "@{concat('Tarefa criada: ', coalesce(triggerBody()?['title'], triggerBody()?['taskTitle'], string(body('Create_SharePoint_Item')?['Title']), ''), ' (Projeto ', coalesce(body('Get_Project_By_Name')?['value']?[0]?['ProjectID'], triggerBody()?['projectId']), ', Item SP ', string(body('Create_SharePoint_Item')?['ID']), ', Planner ', coalesce(string(body('Create_Planner_Task')?['id']), ''), ', Bucket ', outputs('Determine_Bucket_and_Status')?['status'], ').')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
