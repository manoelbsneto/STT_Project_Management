{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "44f187cde7f54f208cf22bac4e533816",
        "connectionReferenceLogicalName": "cat_DataverseIndexerSharePoint",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "displayName": "SharePoint",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1769/1.0.1769.4361/sharepointonline/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      },
      "shared_planner": {
        "connectionName": "6b763b98729c4d99a7a8df4033d381af",
        "connectionReferenceLogicalName": "pmo_sharedplanner_87b5f",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_planner",
        "displayName": "Planner",
        "iconUri": "https://static.powerapps.com/resource/ppcr/releases/v1.0.1808/1.0.1808.4692/planner/icon.png",
        "brandColor": "",
        "tier": "Standard",
        "apiName": "planner",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Action"
                },
                "spItemId": {
                  "type": "string",
                  "description": "SharePoint item ID"
                },
                "taskId": {
                  "type": "string",
                  "description": "SharePoint item ID from card"
                },
                "status": {
                  "type": "string",
                  "description": "Status"
                },
                "taskStatus": {
                  "type": "string",
                  "description": "Status from card"
                },
                "comments": {
                  "type": "string",
                  "description": "Comments"
                },
                "horasRealizadas": {
                  "type": "number",
                  "description": "Completed hours"
                },
                "responsavel": {
                  "type": "string",
                  "description": "Task responsible"
                },
                "dataFim": {
                  "type": "string",
                  "description": "Task due date"
                },
                "prioridade": {
                  "type": "string",
                  "description": "Task priority"
                }
              },
              "required": [
                "action"
              ]
            }
          }
        }
      },
      "actions": {
        "Update_Planner_Task": {
          "runAfter": {
            "Determine_Bucket_and_Percent": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "@body(\u0027Get_SharePoint_Item\u0027)?[\u0027PlannerTaskId\u0027]",
              "body/percentComplete": "@outputs(\u0027Determine_Bucket_and_Percent\u0027)?[\u0027percentComplete\u0027]"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_planner",
              "connectionName": "shared_planner",
              "operationId": "UpdateTask_V2"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
              "type": "Raw"
            }
          }
        },
        "Determine_Bucket_and_Percent": {
          "runAfter": {
            "Get_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027]), \u0027Em Andamento\u0027), json(\u0027{\u0022bucketId\u0022:\u0022ugZSNxsYW0WWCJ5Dtx0-l5cALVXG\u0022,\u0022percentComplete\u0022:50}\u0027), if(equals(coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027]), \u0027Testes\u0027), json(\u0027{\u0022bucketId\u0022:\u00227QYPufh54kum7MP4KUzzAZcAL6Ik\u0022,\u0022percentComplete\u0022:50}\u0027), if(equals(coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027]), \u0027Piloto e Implantacao\u0027), json(\u0027{\u0022bucketId\u0022:\u00224YAXH7iU9E-6jZE2P1DbG5cAMAzH\u0022,\u0022percentComplete\u0022:50}\u0027), if(equals(coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027]), \u0027Concluido\u0027), json(\u0027{\u0022bucketId\u0022:\u0022F2WYUsnXeEue5qlwQuu3GJcAN1Ns\u0022,\u0022percentComplete\u0022:100}\u0027), if(equals(coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027]), \u0027Cancelado\u0027), json(\u0027{\u0022bucketId\u0022:\u002290TcFTFup0CjiHIdzY4gG5cALWKL\u0022,\u0022percentComplete\u0022:100}\u0027), json(\u0027{\u0022bucketId\u0022:\u0022HmzyGOgC4k6uOPm_cwG3zZcAGiAG\u0022,\u0022percentComplete\u0022:0}\u0027))))))"
        },
        "Update_SharePoint_Item": {
          "runAfter": {
            "Update_Planner_Task": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/Status/Value": "@coalesce(triggerBody()?[\u0027status\u0027],triggerBody()?[\u0027taskStatus\u0027])",
              "item/Title": "@body(\u0027Get_SharePoint_Item\u0027)?[\u0027Title\u0027]",
              "id": "@coalesce(triggerBody()?[\u0027spItemId\u0027],triggerBody()?[\u0027taskId\u0027])",
              "item/PlannerSyncStatus/Value": "OK",
              "table": "Tarefas",
              "item/ProjectID": "@body(\u0027Get_SharePoint_Item\u0027)?[\u0027ProjectID\u0027]",
              "item/PlannerBucketId": "@outputs(\u0027Determine_Bucket_and_Percent\u0027)?[\u0027bucketId\u0027]",
              "item/PlannerLastSyncAt": "@utcNow()",
              "item/PlannerSyncError": "",
              "item/HorasRealizadas": "@if(empty(triggerBody()?['horasRealizadas']), coalesce(body('Get_SharePoint_Item')?['HorasRealizadas'], 0), triggerBody()?['horasRealizadas'])",
              "item/Responsavel": "@if(empty(triggerBody()?['responsavel']), coalesce(body('Get_SharePoint_Item')?['Responsavel'], ''), triggerBody()?['responsavel'])",
              "item/DataFim": "@if(empty(triggerBody()?['dataFim']), body('Get_SharePoint_Item')?['DataFim'], triggerBody()?['dataFim'])",
              "item/Prioridade/Value": "@if(empty(triggerBody()?['prioridade']), coalesce(body('Get_SharePoint_Item')?['Prioridade']?['Value'], body('Get_SharePoint_Item')?['Prioridade'], 'Media'), if(startsWith(toLower(triggerBody()?['prioridade']), 'cr'), 'Critica', if(startsWith(toLower(triggerBody()?['prioridade']), 'al'), 'Alta', if(startsWith(toLower(triggerBody()?['prioridade']), 'ba'), 'Baixa', 'Media'))))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
              "type": "Raw"
            }
          }
        },
        "Respond_Success": {
          "runAfter": {
            "Update_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "result": "@{concat('Tarefa ', coalesce(triggerBody()?['taskId'], triggerBody()?['spItemId']), ' atualizada para ', coalesce(triggerBody()?['status'], triggerBody()?['taskStatus'], string(body('Update_SharePoint_Item')?['Status']?['Value']), ''), '. Responsavel: ', if(empty(triggerBody()?['responsavel']), 'mantido', triggerBody()?['responsavel']), '. Prazo: ', if(empty(triggerBody()?['dataFim']), 'mantido', triggerBody()?['dataFim']), '. Item SP: ', string(body('Update_SharePoint_Item')?['ID']), '. Planner percent: ', string(outputs('Determine_Bucket_and_Percent')?['percentComplete']), '.')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Get_SharePoint_Item": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "table": "Tarefas",
              "id": "@coalesce(triggerBody()?[\u0027spItemId\u0027],triggerBody()?[\u0027taskId\u0027])",
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
              "type": "Raw"
            }
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
