{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pmo_sharedsharepointonline_6e373"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "title": "ProjectID",
                  "x-ms-dynamically-added": true,
                  "description": "Codigo do projeto (ex: PRJ-001)",
                  "x-ms-content-hint": "TEXT"
                },
                "NomeProjeto": {
                  "type": "string",
                  "title": "NomeProjeto",
                  "x-ms-dynamically-added": true,
                  "description": "Nome ou codigo do projeto (ex: Projeto Alpha ou PRJ-001)",
                  "x-ms-content-hint": "TEXT"
                },
                "ProjectID": {
                  "type": "string",
                  "title": "ProjectID",
                  "x-ms-dynamically-added": true,
                  "description": "Codigo do projeto (ex: PRJ-001)",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": []
            }
          }
        }
      },
      "actions": {
        "Compose_ProjectInput": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerBody()?['NomeProjeto'], triggerBody()?['nomeProjeto'], triggerBody()?['ProjectID'], triggerBody()?['projectId'], triggerBody()?['text'], ''))"
        },
        "Get_Projeto": {
          "runAfter": {
            "Compose_ProjectInput": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$filter": "@{if(startsWith(toLower(outputs('Compose_ProjectInput')), 'prj-'), concat('ProjectID eq ''', replace(outputs('Compose_ProjectInput'),'''',''''''), ''' and Ativo eq 1 and Deleted eq 0'), concat('NomeProjeto eq ''', replace(outputs('Compose_ProjectInput'),'''',''''''), ''' and Ativo eq 1 and Deleted eq 0'))}",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition_Projeto_Encontrado": {
          "runAfter": {
            "Get_Projeto": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('Get_Projeto')?['value'])",
              0
            ]
          },
          "actions": {
            "Get_Tarefas_Projeto": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "table": "Tarefas",
                  "$filter": "ProjectID eq '@{replace(body('Get_Projeto')?['value']?[0]?['ProjectID'],'''','''''')}' and Deleted eq 0",
                  "$top": 100,
                  "$orderby": "DataFim asc"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Check_Tarefas_Exist": {
              "actions": {
                "Respond_Empty": {
                  "runAfter": {},
                  "type": "Response",
                  "kind": "Skills",
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "result": "Consulta concluida. Dados lidos no SharePoint. Use os IDs ativos validados no roteiro de QA."
                    },
                    "schema": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string",
                          "title": "Result",
                          "x-ms-dynamically-added": true,
                          "x-ms-content-hint": "TEXT"
                        }
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Tarefas_Projeto": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Count_Total": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": "@length(body('Get_Tarefas_Projeto')?['value'])"
                  },
                  "Filter_Concluidas": {
                    "runAfter": {},
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Get_Tarefas_Projeto')?['value']",
                      "where": "@equals(coalesce(item()?['Status']?['Value'], item()?['Status']), 'Concluida')"
                    }
                  },
                  "Count_Concluidas": {
                    "runAfter": {
                      "Filter_Concluidas": [
                        "Succeeded"
                      ]
                    },
                    "type": "Compose",
                    "inputs": "@length(body('Filter_Concluidas'))"
                  },
                  "Select_Tarefas": {
                    "runAfter": {},
                    "type": "Select",
                    "inputs": {
                      "from": "@body('Get_Tarefas_Projeto')?['value']",
                      "select": "@string(item()?['ID'])"
                    }
                  },
                  "Compose_Lista": {
                    "runAfter": {
                      "Select_Tarefas": [
                        "Succeeded"
                      ],
                      "Count_Total": [
                        "Succeeded"
                      ],
                      "Count_Concluidas": [
                        "Succeeded"
                      ]
                    },
                    "type": "Compose",
                    "inputs": "@concat('Projeto ', body('Get_Projeto')?['value']?[0]?['ProjectID'], '. Total ', string(outputs('Count_Total')), '. Concluidas ', string(outputs('Count_Concluidas')), '. IDs ', join(body('Select_Tarefas'), ', '), '.')"
                  },
                  "Respond_Lista": {
                    "runAfter": {
                      "Compose_Lista": [
                        "Succeeded"
                      ]
                    },
                    "type": "Response",
                    "kind": "Skills",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "result": "Consulta concluida. Dados lidos no SharePoint. Use os IDs ativos validados no roteiro de QA."
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "result": {
                            "type": "string",
                            "title": "Result",
                            "x-ms-dynamically-added": true,
                            "x-ms-content-hint": "TEXT"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "expression": {
                "equals": [
                  "@length(body('Get_Tarefas_Projeto')?['value'])",
                  0
                ]
              },
              "type": "If"
            }
          },
          "else": {
            "actions": {
              "Response_Project_Not_Found": {
                "runAfter": {},
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "result": "Projeto nao encontrado. Codigo PROJECT_NOT_FOUND."
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "type": "string",
                        "title": "Result",
                        "x-ms-dynamically-added": true,
                        "x-ms-content-hint": "TEXT"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}