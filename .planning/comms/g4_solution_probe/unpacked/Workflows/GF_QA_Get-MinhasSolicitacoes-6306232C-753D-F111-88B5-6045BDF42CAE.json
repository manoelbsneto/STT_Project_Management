{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedsharepointonline_2b2bc"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-trigger"
          },
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "description": "Email do colaborador autenticado",
                  "title": "email",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "email"
              ]
            }
          }
        }
      },
      "actions": {
        "Sanitizar_Email": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-sanitize-email"
          },
          "type": "Compose",
          "inputs": "@replace(trim(toLower(triggerBody()?['email'])),'''','''''')"
        },
        "Inicializar_var_success": {
          "runAfter": {
            "Sanitizar_Email": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-success"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_success",
                "type": "Boolean",
                "value": false
              }
            ]
          }
        },
        "Inicializar_var_message": {
          "runAfter": {
            "Inicializar_var_success": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-message"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_message",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_count": {
          "runAfter": {
            "Inicializar_var_message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-count"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_count",
                "type": "Integer",
                "value": 0
              }
            ]
          }
        },
        "Inicializar_var_errorCode": {
          "runAfter": {
            "Inicializar_var_count": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-errorcode"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_errorCode",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Obter_itens": {
          "runAfter": {
            "Inicializar_var_latestStatus": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-getitems"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
              "table": "GF_QA_SOLICITACOES_FERIAS",
              "$filter": "ColaboradorEmail eq '@{outputs('Sanitizar_Email')}'",
              "$orderby": "ID desc",
              "$top": 5
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Definir_var_success_sucesso": {
          "runAfter": {
            "Obter_itens": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-success"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_success",
            "value": true
          }
        },
        "Definir_var_count_sucesso": {
          "runAfter": {
            "Definir_var_success_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-count"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_count",
            "value": "@length(body('Obter_itens')?['value'])"
          }
        },
        "Definir_var_message_sucesso": {
          "runAfter": {
            "Definir_var_solicitacoesResumo_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-message-success"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "@variables('var_solicitacoesResumo')"
          }
        },
        "Definir_var_success_erro": {
          "runAfter": {
            "Obter_itens": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-success-error"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_success",
            "value": false
          }
        },
        "Definir_var_errorCode_erro": {
          "runAfter": {
            "Definir_var_success_erro": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-errorcode"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_errorCode",
            "value": "ERRO_OBTER_SOLICITACOES"
          }
        },
        "Definir_var_message_erro": {
          "runAfter": {
            "Definir_var_errorCode_erro": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-message-error"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "Falha ao consultar solicitações do colaborador."
          }
        },
        "Responder_ao_agente": {
          "runAfter": {
            "Definir_var_message_sucesso": [
              "Succeeded",
              "Skipped"
            ],
            "Definir_var_message_erro": [
              "Succeeded",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-respond-agent"
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "title": "count",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "errorcode": {
                  "title": "errorCode",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "message": {
                  "title": "message",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "success": {
                  "title": "success",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                },
                "solicitacoesResumo": {
                  "title": "solicitacoesResumo",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "latestId": {
                  "title": "latestId",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "latestDataInicio": {
                  "title": "latestDataInicio",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "latestDataFim": {
                  "title": "latestDataFim",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "latestDiasUteis": {
                  "title": "latestDiasUteis",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "latestStatus": {
                  "title": "latestStatus",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "count": "@variables('var_count')",
              "errorcode": "@variables('var_errorCode')",
              "message": "@variables('var_message')",
              "success": "@variables('var_success')",
              "solicitacoesResumo": "@variables('var_solicitacoesResumo')",
              "latestId": "@variables('var_latestId')",
              "latestDataInicio": "@variables('var_latestDataInicio')",
              "latestDataFim": "@variables('var_latestDataFim')",
              "latestDiasUteis": "@variables('var_latestDiasUteis')",
              "latestStatus": "@variables('var_latestStatus')"
            }
          }
        },
        "Inicializar_var_solicitacoesResumo": {
          "runAfter": {
            "Inicializar_var_errorCode": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_solicitacoesResumo"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_solicitacoesResumo",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_latestId": {
          "runAfter": {
            "Inicializar_var_solicitacoesResumo": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_latestId"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_latestId",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_latestDataInicio": {
          "runAfter": {
            "Inicializar_var_latestId": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_latestDataInicio"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_latestDataInicio",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_latestDataFim": {
          "runAfter": {
            "Inicializar_var_latestDataInicio": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_latestDataFim"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_latestDataFim",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_latestDiasUteis": {
          "runAfter": {
            "Inicializar_var_latestDataFim": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_latestDiasUteis"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_latestDiasUteis",
                "type": "Integer",
                "value": 0
              }
            ]
          }
        },
        "Inicializar_var_latestStatus": {
          "runAfter": {
            "Inicializar_var_latestDiasUteis": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-init-var_latestStatus"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_latestStatus",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Definir_var_latestId_sucesso": {
          "runAfter": {
            "Definir_var_count_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_latestId"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_latestId",
            "value": "@if(greater(variables('var_count'),0), string(first(body('Obter_itens')?['value'])?['ID']), '')"
          }
        },
        "Definir_var_latestDataInicio_sucesso": {
          "runAfter": {
            "Definir_var_latestId_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_latestDataInicio"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_latestDataInicio",
            "value": "@if(greater(variables('var_count'),0), formatDateTime(first(body('Obter_itens')?['value'])?['DataInicio'], 'dd/MM/yyyy'), '')"
          }
        },
        "Definir_var_latestDataFim_sucesso": {
          "runAfter": {
            "Definir_var_latestDataInicio_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_latestDataFim"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_latestDataFim",
            "value": "@if(greater(variables('var_count'),0), formatDateTime(first(body('Obter_itens')?['value'])?['DataFim'], 'dd/MM/yyyy'), '')"
          }
        },
        "Definir_var_latestDiasUteis_sucesso": {
          "runAfter": {
            "Definir_var_latestDataFim_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_latestDiasUteis"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_latestDiasUteis",
            "value": "@if(greater(variables('var_count'),0), int(first(body('Obter_itens')?['value'])?['DiasUteis']), 0)"
          }
        },
        "Definir_var_latestStatus_sucesso": {
          "runAfter": {
            "Definir_var_latestDiasUteis_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_latestStatus"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_latestStatus",
            "value": "@if(greater(variables('var_count'),0), string(coalesce(first(body('Obter_itens')?['value'])?['Status']?['Value'], first(body('Obter_itens')?['value'])?['Status'])), '')"
          }
        },
        "Definir_var_solicitacoesResumo_sucesso": {
          "runAfter": {
            "Definir_var_latestStatus_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "get-minhas-solicitacoes-set-var_solicitacoesResumo"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_solicitacoesResumo",
            "value": "@if(equals(variables('var_count'),0), 'Nenhuma solicitação encontrada para este colaborador.', concat('Encontrei ', string(variables('var_count')), ' solicitações. Mais recente: ID ', variables('var_latestId'), ' | ', variables('var_latestDataInicio'), ' a ', variables('var_latestDataFim'), ' | ', string(variables('var_latestDiasUteis')), ' dias úteis | Status: ', variables('var_latestStatus')))"
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}