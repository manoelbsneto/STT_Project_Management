{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "gstf_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-trigger"
          },
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "diasRange": {
                  "description": "Quantidade de dias para consultar: 30, 60 ou 90",
                  "title": "diasRange",
                  "type": "integer",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "diasRange"
              ]
            }
          }
        }
      },
      "actions": {
        "Normalizar_DiasRange": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-normalizar-dias"
          },
          "type": "Compose",
          "inputs": "@if(equals(triggerBody()?['diasRange'], 60), 60, if(equals(triggerBody()?['diasRange'], 90), 90, 30))"
        },
        "Calcular_Data_Inicio": {
          "runAfter": {
            "Normalizar_DiasRange": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-data-inicio"
          },
          "type": "Compose",
          "inputs": "@formatDateTime(utcNow(), 'yyyy-MM-dd')"
        },
        "Calcular_Data_Limite": {
          "runAfter": {
            "Calcular_Data_Inicio": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-data-limite"
          },
          "type": "Compose",
          "inputs": "@formatDateTime(addDays(utcNow(), outputs('Normalizar_DiasRange')), 'yyyy-MM-dd')"
        },
        "Inicializar_var_success": {
          "runAfter": {
            "Calcular_Data_Limite": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-init-success"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_success",
                "type": "Boolean",
                "value": false
              }
            ]
          }
        },
        "Inicializar_var_message": {
          "runAfter": {
            "Inicializar_var_success": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-init-message"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_message",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Inicializar_var_totalRegistros": {
          "runAfter": {
            "Inicializar_var_message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-init-total"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_totalRegistros",
                "type": "Integer",
                "value": 0
              }
            ]
          }
        },
        "Inicializar_var_errorCode": {
          "runAfter": {
            "Inicializar_var_totalRegistros": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-init-errorcode"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_errorCode",
                "type": "String",
                "value": ""
              }
            ]
          }
        },
        "Obter_Ferias_Aprovadas": {
          "runAfter": {
            "Inicializar_var_errorCode": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-get-items"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
              "table": "GF_QA_SOLICITACOES_FERIAS",
              "$filter": "Status eq 'Aprovado' and DataInicio ge '@{outputs('Calcular_Data_Inicio')}' and DataInicio le '@{outputs('Calcular_Data_Limite')}'",
              "$orderby": "DataInicio asc",
              "$top": 100
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Definir_var_success_sucesso": {
          "runAfter": {
            "Obter_Ferias_Aprovadas": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-success"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_success",
            "value": true
          }
        },
        "Definir_var_totalRegistros_sucesso": {
          "runAfter": {
            "Definir_var_success_sucesso": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-total"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_totalRegistros",
            "value": "@length(body('Obter_Ferias_Aprovadas')?['value'])"
          }
        },
        "Condicao_Tem_Resultados": {
          "actions": {
            "Definir_var_message_cabecalho": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "report-ferias-proximas-set-message-header"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "var_message",
                "value": "@concat('Encontrei ', string(variables('var_totalRegistros')), ' ferias aprovadas nos proximos ', string(outputs('Normalizar_DiasRange')), ' dias:')"
              }
            },
            "Para_Cada_Solicitacao": {
              "foreach": "@body('Obter_Ferias_Aprovadas')?['value']",
              "actions": {
                "Acrescentar_Linha_Resumo": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "report-ferias-proximas-append-line"
                  },
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "var_message",
                    "value": "@concat(decodeUriComponent('%0A'), '- ', coalesce(items('Para_Cada_Solicitacao')?['ColaboradorEmail'], 'colaborador sem email'), ' | ', if(empty(items('Para_Cada_Solicitacao')?['DataInicio']), 'sem inicio', formatDateTime(items('Para_Cada_Solicitacao')?['DataInicio'], 'dd/MM/yyyy')), ' a ', if(empty(items('Para_Cada_Solicitacao')?['DataFim']), 'sem fim', formatDateTime(items('Para_Cada_Solicitacao')?['DataFim'], 'dd/MM/yyyy')), ' | ', string(coalesce(items('Para_Cada_Solicitacao')?['DiasUteis'], 0)), ' dias uteis | ID ', string(items('Para_Cada_Solicitacao')?['ID']))"
                  }
                }
              },
              "runAfter": {
                "Definir_var_message_cabecalho": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "report-ferias-proximas-foreach"
              },
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            }
          },
          "runAfter": {
            "Definir_var_totalRegistros_sucesso": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Definir_var_message_sem_resultados": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "report-ferias-proximas-set-message-empty"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "var_message",
                  "value": "@concat('Nao encontrei ferias aprovadas nos proximos ', string(outputs('Normalizar_DiasRange')), ' dias.')"
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@variables('var_totalRegistros')",
                  0
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-condition-results"
          },
          "type": "If"
        },
        "Definir_var_success_erro": {
          "runAfter": {
            "Obter_Ferias_Aprovadas": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-error-success"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_success",
            "value": false
          }
        },
        "Definir_var_totalRegistros_erro": {
          "runAfter": {
            "Definir_var_success_erro": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-error-total"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_totalRegistros",
            "value": 0
          }
        },
        "Definir_var_errorCode_erro": {
          "runAfter": {
            "Definir_var_totalRegistros_erro": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-errorcode"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_errorCode",
            "value": "REPORT_FERIAS_QUERY_FAILED"
          }
        },
        "Definir_var_message_erro": {
          "runAfter": {
            "Definir_var_errorCode_erro": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-set-error-message"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "Nao consegui consultar as ferias aprovadas agora. Tente novamente em instantes."
          }
        },
        "Responder_ao_agente": {
          "runAfter": {
            "Condicao_Tem_Resultados": [
              "Succeeded",
              "Skipped"
            ],
            "Definir_var_message_erro": [
              "Succeeded",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "report-ferias-proximas-respond-agent"
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "success",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                },
                "totalRegistros": {
                  "title": "totalRegistros",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "message": {
                  "title": "message",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "errorcode": {
                  "title": "errorCode",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "success": "@variables('var_success')",
              "totalRegistros": "@variables('var_totalRegistros')",
              "message": "@variables('var_message')",
              "errorcode": "@variables('var_errorCode')"
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}