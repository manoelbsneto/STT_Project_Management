                "type": "String",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-solicitacaoid"
          }
        },
        "Inicializar_var_status": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_status",
                "type": "String",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_solicitacaoId": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-status"
          }
        },
        "Inicializar_var_dataInicio": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_dataInicio",
                "type": "String",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_status": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-datainicio"
          }
        },
        "Inicializar_var_dataFim": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_dataFim",
                "type": "String",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_dataInicio": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-datafim"
          }
        },
        "Inicializar_var_diasSolicitados": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_diasSolicitados",
                "type": "Integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_dataFim": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-diassolicitados"
          }
        },
        "Inicializar_var_aprovadorNome": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "var_aprovadorNome",
                "type": "String",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Inicializar_var_diasSolicitados": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-init-aprovadornome"
          }
        },
        "Normalizar_Data_Inicio": {
          "type": "Compose",
          "inputs": "@if(\r\n  contains(trim(string(triggerBody()?['text_1'])),'-'),\r\n  formatDateTime(trim(string(triggerBody()?['text_1'])),'yyyy-MM-dd'),\r\n  if(\r\n    equals(length(split(trim(string(triggerBody()?['text_1'])),'/')),2),\r\n    concat(\r\n      string(\r\n        if(\r\n          empty(triggerBody()?['anoReferencia']),\r\n          int(formatDateTime(utcNow(),'yyyy')),\r\n          int(triggerBody()?['anoReferencia'])\r\n        )\r\n      ),\r\n      '-',\r\n      formatNumber(int(last(split(trim(string(triggerBody()?['text_1'])),'/'))),'00'),\r\n      '-',\r\n      formatNumber(int(first(split(trim(string(triggerBody()?['text_1'])),'/'))),'00')\r\n    ),\r\n    concat(\r\n      formatNumber(int(last(split(trim(string(triggerBody()?['text_1'])),'/'))),'0000'),\r\n      '-',\r\n      formatNumber(int(first(skip(split(trim(string(triggerBody()?['text_1'])),'/'),1))),'00'),\r\n      '-',\r\n      formatNumber(int(first(split(trim(string(triggerBody()?['text_1'])),'/'))),'00')\r\n    )\r\n  )\r\n)",
          "runAfter": {
            "Inicializar_var_aprovadorNome": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-normalizar-data-inicio"
          }
        },
        "Normalizar_Data_Fim": {
          "type": "Compose",
          "inputs": "@if( not(empty(triggerBody()?['diasFerias'])), formatDateTime(addDays(outputs('Normalizar_Data_Inicio'),sub(int(triggerBody()?['diasFerias']),1)),'yyyy-MM-dd'), if( contains(trim(string(triggerBody()?['text_2'])),'-'), formatDateTime(trim(string(triggerBody()?['text_2'])),'yyyy-MM-dd'), if( equals(length(split(trim(string(triggerBody()?['text_2'])),'/')),2), concat( string( if( empty(triggerBody()?['anoReferencia']), int(formatDateTime(utcNow(),'yyyy')), int(triggerBody()?['anoReferencia']) ) ), '-', formatNumber(int(last(split(trim(string(triggerBody()?['text_2'])),'/'))),'00'), '-', formatNumber(int(first(split(trim(string(triggerBody()?['text_2'])),'/'))),'00') ), concat( formatNumber(int(last(split(trim(string(triggerBody()?['text_2'])),'/'))),'0000'), '-', formatNumber(int(first(skip(split(trim(string(triggerBody()?['text_2'])),'/'),1))),'00'), '-', formatNumber(int(first(split(trim(string(triggerBody()?['text_2'])),'/'))),'00') ) ) ) )",
          "runAfter": {
            "Normalizar_Data_Inicio": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-normalizar-data-fim"
          }
        },
        "Definir_var_errorCode_formato_data_invalido": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_errorCode",
            "value": "FORMATO_DATA_INVALIDO"
          },
          "runAfter": {
            "Normalizar_Data_Inicio": [
              "Failed",
              "TimedOut"
            ],
            "Normalizar_Data_Fim": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-error-invalid-date-format"
          }
        },
        "Definir_var_message_formato_data_invalido": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "Formato inválido. Use dataInicio em YYYY-MM-DD ou DD/MM. Informe dataFim no mesmo formato, ou informe diasFerias."
          },
          "runAfter": {
            "Definir_var_errorCode_formato_data_invalido": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-message-invalid-date-format"
          }
        },
        "Condition_Datas_Validas": {
          "type": "Compose",
          "inputs": "@if(greaterOrEquals(ticks(outputs('Normalizar_Data_Fim')), ticks(outputs('Normalizar_Data_Inicio'))), 'OK', int('DATA_INVALIDA'))",
          "runAfter": {
            "Normalizar_Data_Fim": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-condition-datas-validas"
          }
        },
        "Definir_var_errorCode_data_invalida": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_errorCode",
            "value": "DATA_INVALIDA"
          },
          "runAfter": {
            "Condition_Datas_Validas": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-error-invalid-date"
          }
        },
        "Definir_var_message_data_invalida": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "A data final deve ser maior ou igual à data inicial."
          },
          "runAfter": {
            "Definir_var_errorCode_data_invalida": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-message-invalid-date"
          }
        },
        "Definir_var_dataInicio_normalizada": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_dataInicio",
            "value": "@outputs('Normalizar_Data_Inicio')"
          },
          "runAfter": {
            "Condition_Datas_Validas": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-datainicio"
          }
        },
        "Definir_var_dataFim_normalizada": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_dataFim",
            "value": "@outputs('Normalizar_Data_Fim')"
          },
          "runAfter": {
            "Definir_var_dataInicio_normalizada": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-datafim"
          }
        },
        "Obter_Colaborador": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
              "table": "GF_QA_USUARIOS_APROVADORES",
              "$filter": "ColaboradorEmail eq '@{outputs('Sanitizar_Email')}'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          },
          "runAfter": {
            "Definir_var_dataFim_normalizada": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-get-colaborador"
          }
        },
        "Definir_var_errorCode_erro_obter_colaborador": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_errorCode",
            "value": "ERRO_OBTER_COLABORADOR"
          },
          "runAfter": {
            "Obter_Colaborador": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-error-get-colaborador"
          }
        },
        "Definir_var_message_erro_obter_colaborador": {
          "type": "SetVariable",
          "inputs": {
            "name": "var_message",
            "value": "Falha ao consultar dados do colaborador."
          },
          "runAfter": {
            "Definir_var_errorCode_erro_obter_colaborador": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "criar-solicitacao-set-message-get-colaborador"
          }
        },
        "Condition_Colaborador_Existe": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Obter_Colaborador')?['value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Definir_var_aprovadorNome": {
              "type": "SetVariable",
              "inputs": {
                "name": "var_aprovadorNome",
                "value": "@{first(body('Obter_Colaborador')?['value'])?['AprovadorNome']}"
              },
              "metadata": {
                "operationMetadataId": "criar-solicitacao-set-aprovadornome"
              }
            },
            "Obter_Saldo": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
                  "table": "GF_QA_SALDO_ATUAL",
                  "$filter": "ColaboradorEmail eq '@{outputs('Sanitizar_Email')}'"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline-1"
                }
              },
              "runAfter": {
                "Definir_var_aprovadorNome": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "criar-solicitacao-get-saldo"
              }
            },
            "Definir_var_errorCode_erro_obter_saldo": {
              "type": "SetVariable",
              "inputs": {
                "name": "var_errorCode",
                "value": "ERRO_OBTER_SALDO"
              },
              "runAfter": {
                "Obter_Saldo": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "metadata": {
                "operationMetadataId": "criar-solicitacao-set-error-get-saldo"
              }
            },
            "Definir_var_message_erro_obter_saldo": {
              "type": "SetVariable",
              "inputs": {
                "name": "var_message",
                "value": "Falha ao consultar saldo do colaborador."
              },
              "runAfter": {
                "Definir_var_errorCode_erro_obter_saldo": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "criar-solicitacao-set-message-get-saldo"
              }
            },
            "Condition_Saldo_Existe": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Obter_Saldo')?['value'])",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Calcular_Dias_Uteis": {
                  "type": "Compose",
                  "inputs": "@if(not(empty(triggerBody()?['diasFerias'])), int(triggerBody()?['diasFerias']), max(0, add(add(div(sub(ticks(outputs('Normalizar_Data_Fim')), ticks(outputs('Normalizar_Data_Inicio'))), 864000000000), 1), mul(-1, add(div(sub(ticks(outputs('Normalizar_Data_Fim')), ticks(outputs('Normalizar_Data_Inicio'))), 6048000000000), if(greaterOrEquals(mod(dayOfWeek(outputs('Normalizar_Data_Inicio')), 7), mod(dayOfWeek(outputs('Normalizar_Data_Fim')), 7)), 2, 0))))))",
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-calc-dias"
                  }
                },
                "Definir_var_diasSolicitados_calculado": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "var_diasSolicitados",
                    "value": "@outputs('Calcular_Dias_Uteis')"
                  },
                  "runAfter": {
                    "Calcular_Dias_Uteis": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-set-diassolicitados"
                  }
                },
                "Calcular_Dias_Venda": {
                  "type": "Compose",
                  "inputs": "@if(empty(triggerBody()?['diasVenda']), 0, int(triggerBody()?['diasVenda']))",
                  "runAfter": {
                    "Definir_var_diasSolicitados_calculado": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-calc-venda"
                  }
                },
                "Calcular_Dias_Comprometidos": {
                  "type": "Compose",
                  "inputs": "@add(outputs('Calcular_Dias_Uteis'), outputs('Calcular_Dias_Venda'))",
                  "runAfter": {
                    "Calcular_Dias_Venda": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-calc-comprometidos"
                  }
                },
                "Definir_var_errorCode_erro_calcular_dias": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "var_errorCode",
                    "value": "ERRO_CALCULO_DIAS"
                  },
                  "runAfter": {
                    "Calcular_Dias_Uteis": [
                      "Failed",
                      "TimedOut"
                    ],
                    "Calcular_Dias_Venda": [
                      "Failed",
                      "TimedOut"
                    ],
                    "Calcular_Dias_Comprometidos": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-set-error-calc-dias"
                  }
                },
                "Definir_var_message_erro_calcular_dias": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "var_message",
                    "value": "Não foi possível calcular os dias. Verifique datas e campos numéricos (diasFerias/diasVenda)."
                  },
                  "runAfter": {
                    "Definir_var_errorCode_erro_calcular_dias": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-set-message-calc-dias"
                  }
                },
                "Obter_Solicitacoes_Conflitantes": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
                      "table": "GF_QA_SOLICITACOES_FERIAS",
                      "$filter": "ColaboradorEmail eq '@{outputs('Sanitizar_Email')}' and (Status eq 'Pendente' or Status eq 'Aprovado') and DataInicio le '@{outputs('Normalizar_Data_Fim')}' and DataFim ge '@{outputs('Normalizar_Data_Inicio')}'"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline-1"
                    }
                  },
                  "runAfter": {
                    "Calcular_Dias_Comprometidos": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-get-conflitos"
                  }
                },
                "Definir_var_errorCode_erro_obter_conflitos": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "var_errorCode",
                    "value": "ERRO_VALIDACAO_CONFLITO"
                  },
                  "runAfter": {
                    "Obter_Solicitacoes_Conflitantes": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-set-error-get-conflitos"
                  }
                },
                "Definir_var_message_erro_obter_conflitos": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "var_message",
                    "value": "Falha ao validar conflito de datas."
                  },
                  "runAfter": {
                    "Definir_var_errorCode_erro_obter_conflitos": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "criar-solicitacao-set-message-get-conflitos"
                  }
                },
                "Condition_Saldo_Suficiente": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@outputs('Calcular_Dias_Uteis')",
                          0
                        ]
                      },
                      {
                        "or": [
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              ""
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "5"
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "10"
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "15"
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "20"
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "25"
                            ]
                          },
                          {
                            "equals": [
                              "@string(triggerBody()?['diasFerias'])",
                              "30"
                            ]
                          }
                        ]
                      },
                      {
                        "greaterOrEquals": [
                          "@first(body('Obter_Saldo')?['value'])?['SaldoDisponivel']",
                          "@outputs('Calcular_Dias_Comprometidos')"
                        ]
                      },
                      {
                        "equals": [
                          "@length(body('Obter_Solicitacoes_Conflitantes')?['value'])",
                          0
                        ]
                      },
                      {
                        "greaterOrEquals": [
                          "@outputs('Calcular_Dias_Venda')",
                          0
                        ]
                      },
                      {
                        "lessOrEquals": [
                          "@outputs('Calcular_Dias_Venda')",
                          10
                        ]
                      },
                      {
                        "lessOrEquals": [
                          "@outputs('Calcular_Dias_Comprometidos')",
                          30
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Criar_Solicitacao": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Arquitetura_Solucoes_Multi_Praticas_QA",
                          "table": "GF_QA_SOLICITACOES_FERIAS",
                          "item/Title": "@{concat('Solicitacao de Ferias - ', outputs('Sanitizar_Email'), ' - ', formatDateTime(outputs('Normalizar_Data_Inicio'), 'dd/MM/yyyy'), ' a ', formatDateTime(outputs('Normalizar_Data_Fim'), 'dd/MM/yyyy'))}",
                          "item/ColaboradorEmail": "@{outputs('Sanitizar_Email')}",
                          "item/AprovadorEmail": "@{coalesce(first(body('Obter_Colaborador')?['value'])?['AprovadorEmail'], '')}",
