:\"Adiada\",\"cardVersion\":\"1.0\"}}]}\u0027, \u0027${DecisionID}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027DecisionID\u0027], triggerBody()?[\u0027DecisionID\u0027], \u0027-\u0027)), \u0027${ProjectName}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027ProjectID\u0027], triggerBody()?[\u0027ProjectID\u0027], \u0027-\u0027)), \u0027${Solicitante}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Solicitante\u0027]?[\u0027DisplayName\u0027], body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Solicitante\u0027]?[\u0027Email\u0027], \u0027-\u0027)), \u0027${Prazo}\u0027, coalesce(string(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Prazo\u0027]), \u0027-\u0027)), \u0027${Impacto}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Impacto\u0027]?[\u0027Value\u0027], body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Impacto\u0027], \u0027-\u0027)), \u0027${Descricao}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Descricao\u0027], \u0027-\u0027))",
