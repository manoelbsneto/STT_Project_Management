{
  "name": "4b6b0fe9-9866-4cec-b66a-6a22c366223f",
  "id": "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/4b6b0fe9-9866-4cec-b66a-6a22c366223f",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "PMO_PA_CriarTarefa",
    "userType": "Owner",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "title": "ProjectID",
                  "x-ms-dynamically-added": true,
                  "description": "Código do projeto (ex: PRJ-001)",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "type": "string",
                  "title": "Titulo",
                  "x-ms-dynamically-added": true,
                  "description": "Título da tarefa",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "type": "string",
                  "title": "Responsavel",
                  "x-ms-dynamically-added": true,
                  "description": "Email do responsável",
                  "x-ms-content-hint": "TEXT"
                },
                "text_3": {
                  "type": "string",
                  "title": "DataInicio",
                  "x-ms-dynamically-added": true,
                  "description": "Data de início (YYYY-MM-DD)",
                  "x-ms-content-hint": "TEXT"
                },
                "text_4": {
                  "type": "string",
                  "title": "DataFim",
                  "x-ms-dynamically-added": true,
                  "description": "Data de fim (YYYY-MM-DD)",
                  "x-ms-content-hint": "TEXT"
                },
                "number": {
                  "type": "number",
                  "title": "HorasEstimadas",
                  "x-ms-dynamically-added": true,
                  "description": "Horas estimadas para a tarefa",
                  "x-ms-content-hint": "NUMBER"
                },
                "text_5": {
                  "type": "string",
                  "title": "Prioridade",
                  "x-ms-dynamically-added": true,
                  "description": "Prioridade: Baixa, Média, Alta, Crítica",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1"
              ]
            }
          }
        }
      },
      "actions": {
        "Validate_ProjectID": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$filter": "ProjectID eq '@{triggerBody()?['text']}'",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Check_Project_Exists": {
          "actions": {
            "Respond_Error_ProjectID": {
              "runAfter": {},
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "result": "❌ Projeto '@{triggerBody()?['text']}' não encontrado. Verifique o código do projeto e tente novamente."
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "title": "Result",
                      "x-ms-dynamically-added": true,
                      "x-ms-content-hint": "TEXT"
                    }
                  }
                }
              }
            },
            "Terminate_Invalid": {
              "runAfter": {
                "Respond_Error_ProjectID": [
                  "Succeeded"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "runAfter": {
            "Validate_ProjectID": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Create_Tarefa": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                    "table": "Tarefas",
                    "item/Title": "@triggerBody()?['text_1']",
                    "item/ProjectID": "@triggerBody()?['text']",
                    "item/Responsavel": "@coalesce(triggerBody()?['text_2'], '')",
                    "item/DataInicio": "@if(empty(triggerBody()?['text_3']), null, triggerBody()?['text_3'])",
                    "item/DataFim": "@if(empty(triggerBody()?['text_4']), null, triggerBody()?['text_4'])",
                    "item/HorasEstimadas": "@coalesce(triggerBody()?['number'], 0)",
                    "item/Status": {
                      "Value": "Pendente"
                    },
                    "item/HorasRealizadas": 0,
                    "item/Prioridade": {
                      "Value": "@{coalesce(triggerBody()?['text_5'], 'Média')}"
                    }
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem"
                  },
                  "authentication": {
                    "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                    "type": "Raw"
                  }
                }
              },
              "Respond_Success": {
                "runAfter": {
                  "Create_Tarefa": [
                    "Succeeded"
                  ]
                },
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "result": "✅ Tarefa criada com sucesso!\n\n📋 **ID:** @{body('Create_Tarefa')?['ID']}\n📌 **Título:** @{triggerBody()?['text_1']}\n📁 **Projeto:** @{triggerBody()?['text']}\n👤 **Responsável:** @{coalesce(triggerBody()?['text_2'], 'Não definido')}\n📅 **Prazo:** @{coalesce(triggerBody()?['text_4'], 'Não definido')}\n⏱️ **Horas estimadas:** @{coalesce(triggerBody()?['number'], 0)}\n🔖 **Prioridade:** @{coalesce(triggerBody()?['text_5'], 'Média')}\n📊 **Status:** Pendente"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "type": "string",
                        "title": "Result",
                        "x-ms-dynamically-added": true,
                        "x-ms-content-hint": "TEXT"
                      }
                    }
                  }
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@length(body('Validate_ProjectID')?['value'])",
              0
            ]
          },
          "type": "If"
        }
      }
    },
