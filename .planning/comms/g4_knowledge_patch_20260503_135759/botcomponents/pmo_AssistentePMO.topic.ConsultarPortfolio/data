kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: ConsultarPortfolio
    includeInOnSelectIntent: false
    triggerQueries:
      - como está o portfólio
      - como esta o portfolio
      - resumo dos projetos
      - dashboard
      - portfolio pmo

  actions:
    - kind: SendActivity
      id: portfolio_stub
      activity: |-
        Portfólio PMO
        Verde: consultar lista Projetos onde Ativo=Yes e StatusRAG=Verde.
        Amarelo: consultar lista Projetos onde Ativo=Yes e StatusRAG=Amarelo.
        Vermelho: consultar lista Projetos onde Ativo=Yes e StatusRAG=Vermelho.
        Total: consultar lista Projetos onde Ativo=Yes.
        Sem atualização (>24h): consultar Projetos com UltimaAtualizacao anterior a utcNow()-1 dia.