{
    "name":  "7ca90102-525b-48bb-875e-0f7bda96f85b",
    "type":  "Microsoft.ProcessSimple/environments/flows",
    "id":  "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/7ca90102-525b-48bb-875e-0f7bda96f85b",
    "properties":  {
                       "apiId":  "/providers/Microsoft.PowerApps/apis/shared_logicflows",
                       "displayName":  "PMO_PA_CriarTarefa",
                       "definition":  {
                                          "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                                          "contentVersion":  "1.0.0.0",
                                          "parameters":  {
                                                             "$authentication":  {
                                                                                     "defaultValue":  {

                                                                                                      },
                                                                                     "type":  "SecureObject"
                                                                                 },
                                                             "$connections":  {
                                                                                  "defaultValue":  {

                                                                                                   },
                                                                                  "type":  "Object"
                                                                              }
                                                         },
                                          "triggers":  {
                                                           "Copilot_CriarTarefa_Request":  {
                                                                                               "type":  "Request",
                                                                                               "kind":  "Skills",
                                                                                               "inputs":  {
                                                                                                              "schema":  {
                                                                                                                             "type":  "object",
                                                                                                                             "properties":  {
                                                                                                                                                "nomeProjeto":  {
                                                                                                                                                                    "type":  "string",
                                                                                                                                                                    "description":  "Nome do projeto (fornecido pelo PM)"
                                                                                                                                                                },
                                                                                                                                                "titulo":  {
                                                                                                                                                               "type":  "string",
                                                                                                                                                               "description":  "Titulo da tarefa/projeto"
                                                                                                                                                           },
                                                                                                                                                "responsavel":  {
                                                                                                                                                                    "type":  "string",
                                                                                                                                                                    "description":  "Nome do responsavel"
                                                                                                                                                                },
                                                                                                                                                "prazo":  {
                                                                                                                                                              "type":  "string",
                                                                                                                                                              "description":  "Data alvo no formato ISO 8601 ou dd/MM/yyyy"
                                                                                                                                                          },
                                                                                                                                                "horas":  {
                                                                                                                                                              "type":  "integer",
                                                                                                                                                              "description":  "Horas estimadas"
                                                                                                                                                          },
                                                                                                                                                "prioridade":  {
                                                                                                                                                                   "type":  "string",
                                                                                                                                                                   "description":  "Prioridade: Alta, Media, Baixa ou Critica"
                                                                                                                                                               }
                                                                                                                                            },
                                                                                                                             "required":  [
                                                                                                                                              "titulo",
                                                                                                                                              "responsavel",
                                                                                                                                              "prazo",
                                                                                                                                              "prioridade"
                                                                                                                                          ]
                                                                                                                         }
                                                                                                          }
                                                                                           }
                                                       },
                                          "actions":  {
                                                          "Compose_NomeProjeto":  {
                                                                                      "type":  "Compose",
                                                                                      "inputs":  "@coalesce(triggerBody()?[\u0027nomeProjeto\u0027], triggerBody()?[\u0027titulo\u0027], \u0027Sem nome\u0027)",
                                                                                      "runAfter":  {
                                                                                                       "Map_Prioridade":  [
                                                                                                                              "Succeeded"
                                                                                                                          ]
                                                                                                   }
                                                                                  },
                                                          "Response_Success":  {
                                                                                   "type":  "Response",
                                                                                   "kind":  "Skills",
                                                                                   "inputs":  {
                                                                                                  "statusCode":  200,
                                                                                                  "headers":  {
                                                                                                                  "Content-Type":  "application/json"
                                                                                                              },
                                                                                                  "body":  {
                                                                                                               "success":  true,
                                                                                                               "message":  "@{concat(\u0027Projeto \u0027, outputs(\u0027Compose_NomeProjeto\u0027), \u0027 criado com codigo \u0027, outputs(\u0027Compose_New_ProjectID\u0027), \u0027.\u0027)}",
                                                                                                               "errorcode":  "",
                                                                                                               "projectId":  "@{outputs(\u0027Compose_New_ProjectID\u0027)}"
                                                                                                           }
                                                                                              },
                                                                                   "runAfter":  {
                                                                                                    "Create_Projeto_SharePoint":  [
                                                                                                                                      "Succeeded"
                                                                                                                                  ]
                                                                                                }
                                                                               },
                                                          "Create_Projeto_SharePoint":  {
                                                                                            "type":  "OpenApiConnection",
                                                                                            "inputs":  {
                                                                                                           "parameters":  {
                                                                                                                              "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                                                                                                                              "item/Prioridade/Value":  "@outputs(\u0027Map_Prioridade\u0027)",
                                                                                                                              "item/Title":  "@outputs(\u0027Compose_NomeProjeto\u0027)",
                                                                                                                              "item/DataAlvo":  "@triggerBody()?[\u0027prazo\u0027]",
                                                                                                                              "item/Percentual":  0,
                                                                                                                              "item/NomeProjeto":  "@outputs(\u0027Compose_NomeProjeto\u0027)",
                                                                                                                              "table":  "Projetos",
                                                                                                                              "item/ProjectID":  "@outputs(\u0027Compose_New_ProjectID\u0027)",
                                                                                                                              "item/UltimaAtualizacao":  "@utcNow()",
                                                                                                                              "item/StatusRAG/Value":  "Verde",
                                                                                                                              "item/ResumoExecutivo":  "@concat(\u0027Projeto criado via Copilot Studio. Titulo: \u0027, coalesce(triggerBody()?[\u0027titulo\u0027], \u0027-\u0027), \u0027. Horas estimadas: \u0027, coalesce(string(triggerBody()?[\u0027horas\u0027]), \u0027N/A\u0027), \u0027h. Responsavel: \u0027, coalesce(triggerBody()?[\u0027responsavel\u0027], \u0027-\u0027), \u0027. Prazo: \u0027, coalesce(triggerBody()?[\u0027prazo\u0027], \u0027-\u0027), \u0027.\u0027)",
                                                                                                                              "item/Ativo":  true
                                                                                                                          },
                                                                                                           "host":  {
                                                                                                                        "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                                                        "operationId":  "PostItem",
                                                                                                                        "connectionName":  "shared_sharepointonline"
                                                                                                                    },
                                                                                                           "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                       },
                                                                                            "runAfter":  {
                                                                                                             "Compose_NomeProjeto":  [
                                                                                                                                         "Succeeded"
                                                                                                                                     ]
                                                                                                         }
                                                                                        },
                                                          "Get_Existing_Projects":  {
                                                                                        "type":  "OpenApiConnection",
                                                                                        "inputs":  {
                                                                                                       "parameters":  {
                                                                                                                          "table":  "Projetos",
                                                                                                                          "$top":  1,
                                                                                                                          "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                                                                                                                          "$orderby":  "ID desc"
                                                                                                                      },
                                                                                                       "host":  {
                                                                                                                    "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                                                    "operationId":  "GetItems",
                                                                                                                    "connectionName":  "shared_sharepointonline"
                                                                                                                },
                                                                                                       "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                   },
                                                                                        "runAfter":  {

                                                                                                     }
                                                                                    },
                                                          "Compose_New_ProjectID":  {
                                                                                        "type":  "Compose",
                                                                                        "inputs":  "@if(equals(length(body(\u0027Get_Existing_Projects\u0027)?[\u0027value\u0027]), 0), \u0027PRJ-000001\u0027, concat(\u0027PRJ-\u0027, padLeft(string(add(int(last(split(coalesce(first(body(\u0027Get_Existing_Projects\u0027)?[\u0027value\u0027])?[\u0027ProjectID\u0027], \u0027PRJ-0\u0027), \u0027-\u0027))), 1)), 6, \u00270\u0027)))",
                                                                                        "runAfter":  {
                                                                                                         "Get_Existing_Projects":  [
                                                                                                                                       "Succeeded"
                                                                                                                                   ]
                                                                                                     }
                                                                                    },
                                                          "Map_Prioridade":  {
                                                                                 "type":  "Compose",
                                                                                 "inputs":  "@if(or(equals(triggerBody()?[\u0027prioridade\u0027], \u0027Critica\u0027), equals(triggerBody()?[\u0027prioridade\u0027], \u0027CrÃ­tica\u0027)), \u0027Alta\u0027, coalesce(triggerBody()?[\u0027prioridade\u0027], \u0027Media\u0027))",
                                                                                 "runAfter":  {
                                                                                                  "Compose_New_ProjectID":  [
                                                                                                                                "Succeeded"
                                                                                                                            ]
                                                                                              }
                                                                             },
                                                          "Response_Error":  {
                                                                                 "type":  "Response",
                                                                                 "kind":  "Skills",
                                                                                 "inputs":  {
                                                                                                "statusCode":  500,
                                                                                                "headers":  {
                                                                                                                "Content-Type":  "application/json"
                                                                                                            },
                                                                                                "body":  {
                                                                                                             "success":  false,
                                                                                                             "message":  "Erro ao criar projeto no SharePoint.",
                                                                                                             "errorcode":  "SP_CREATE_FAILED",
                                                                                                             "projectId":  ""
                                                                                                         }
                                                                                            },
                                                                                 "runAfter":  {
                                                                                                  "Create_Projeto_SharePoint":  [
                                                                                                                                    "Failed",
                                                                                                                                    "TimedOut"
                                                                                                                                ]
                                                                                              }
                                                                             }
                                                      },
                                          "outputs":  {

                                                      }
                                      },
                       "connectionReferences":  {
                                                    "shared_sharepointonline":  {
                                                                                    "connectionName":  "44f187cde7f54f208cf22bac4e533816",
                                                                                    "connectionReferenceLogicalName":  "pmo_sharepoint",
                                                                                    "source":  "Invoker",
                                                                                    "id":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                    "displayName":  "SharePoint",
                                                                                    "tier":  "Standard",
                                                                                    "apiName":  "sharepointonline",
                                                                                    "isProcessSimpleApiReferenceConversionAlreadyDone":  false
                                                                                }
                                                },
                       "flowOpenAiData":  {
                                              "isConsequential":  false,
                                              "isConsequentialFlagOverwritten":  false
                                          }
                   }
}
