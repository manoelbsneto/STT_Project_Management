{
  "name": "8a3d5eba-6647-4e9a-9036-b8eb5dbe0ec8",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "id": "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/8a3d5eba-6647-4e9a-9036-b8eb5dbe0ec8",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "PMO_PA_CriarTarefa",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Copilot_CriarTarefa_Request": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "nomeProjeto": {
                  "type": "string",
                  "description": "Nome do projeto (fornecido pelo PM)"
                },
                "titulo": {
                  "type": "string",
                  "description": "Titulo da tarefa/projeto"
                },
                "responsavel": {
                  "type": "string",
                  "description": "Nome do responsavel"
                },
                "prazo": {
                  "type": "string",
                  "description": "Data alvo no formato ISO 8601 ou dd/MM/yyyy"
                },
                "horas": {
                  "type": "integer",
                  "description": "Horas estimadas"
                },
                "prioridade": {
                  "type": "string",
                  "description": "Prioridade: Alta, Media, Baixa ou Critica"
                }
              },
              "required": [
                "titulo",
                "responsavel",
                "prazo",
                "prioridade"
              ]
            }
          }
        }
      },
      "actions": {
        "Create_Projeto_SharePoint": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "item/DataAlvo": "@triggerBody()?['prazo']",
              "item/ProjectID": "@outputs('Compose_New_ProjectID')",
              "item/Percentual": 0,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/Title": "@outputs('Compose_NomeProjeto')",
              "item/UltimaAtualizacao": "@utcNow()",
              "item/NomeProjeto": "@outputs('Compose_NomeProjeto')",
              "item/ResumoExecutivo": "@concat('Projeto criado via Copilot Studio. Titulo: ', coalesce(triggerBody()?['titulo'], '-'), '. Horas estimadas: ', coalesce(string(triggerBody()?['horas']), 'N/A'), 'h. Responsavel: ', coalesce(triggerBody()?['responsavel'], '-'), '. Prazo: ', coalesce(triggerBody()?['prazo'], '-'), '.')",
              "item/Ativo": true,
              "item/Prioridade/Value": "@outputs('Map_Prioridade')",
              "table": "Projetos",
              "item/StatusRAG/Value": "Verde"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "PostItem",
              "connectionName": "shared_sharepointonline"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Compose_NomeProjeto": [
              "Succeeded"
            ]
          }
        },
        "Compose_New_ProjectID": {
          "type": "Compose",
          "inputs": "@if(equals(length(body('Get_Existing_Projects')?['value']), 0), 'PRJ-000001', concat('PRJ-', padLeft(string(add(int(last(split(coalesce(first(body('Get_Existing_Projects')?['value'])?['ProjectID'], 'PRJ-0'), '-'))), 1)), 6, '0')))",
          "runAfter": {
            "Get_Existing_Projects": [
              "Succeeded"
            ]
          }
        },
        "Map_Prioridade": {
          "type": "Compose",
          "inputs": "@if(or(equals(triggerBody()?['prioridade'], 'Critica'), equals(triggerBody()?['prioridade'], 'Crítica')), 'Alta', coalesce(triggerBody()?['prioridade'], 'Media'))",
          "runAfter": {
            "Compose_New_ProjectID": [
              "Succeeded"
            ]
          }
        },
        "Response_Success": {
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "success": true,
              "message": "@{concat('Projeto ', outputs('Compose_NomeProjeto'), ' criado com codigo ', outputs('Compose_New_ProjectID'), '.')}",
              "projectId": "@{outputs('Compose_New_ProjectID')}"
            }
          },
          "runAfter": {
            "Create_Projeto_SharePoint": [
              "Succeeded"
            ]
          }
        },
        "Compose_NomeProjeto": {
          "type": "Compose",
          "inputs": "@coalesce(triggerBody()?['nomeProjeto'], triggerBody()?['titulo'], 'Sem nome')",
          "runAfter": {
            "Map_Prioridade": [
              "Succeeded"
            ]
          }
        },
        "Get_Existing_Projects": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "$top": 1,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$orderby": "ID desc"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Response_Error": {
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 500,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "success": false,
              "message": "Erro ao criar projeto no SharePoint.",
              "errorcode": "SP_CREATE_FAILED"
            }
          },
          "runAfter": {
            "Create_Projeto_SharePoint": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "44f187cde7f54f208cf22bac4e533816",
        "connectionReferenceLogicalName": "pmo_sharepoint",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "displayName": "SharePoint",
        "tier": "Standard",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "flowOpenAiData": {
      "isConsequential": false,
      "isConsequentialFlagOverwritten": false
    }
  }
}
