{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "cat_DataverseIndexerSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_teams": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "cat_sharedteams_1ef7e"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Manual_Copilot_Request": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "ProjectID": {
                  "type": "string",
                  "description": "ProjectID to request immediate check-in"
                }
              },
              "required": [
                "ProjectID"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_Projeto": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "$filter": "ProjectID eq '@{triggerBody()?['ProjectID']}'",
              "table": "Projetos",
              "$top": 1,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Post_CheckIn_Wait_Response": {
          "runAfter": {
            "Get_Projeto": [
              "Succeeded"
            ]
          },
          "limit": {
            "timeout": "P28D"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "body/body/recipient/groupId": "96c5b0c4-46cc-46cd-8695-50451db74994",
              "body/body/recipient/channelId": "19:4c8fe80b169f4e698c9b1b15d1868691@thread.tacv2",
              "poster": "Flow bot",
              "body/body/updateMessage": "Resposta registrada. Obrigado.",
              "body/body/messageBody": "@replace(replace('{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"Image\",\"url\":\"https://img.icons8.com/fluency/48/project-management.png\",\"size\":\"Small\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"ðŸ“Š PMO Check-in DiÃ¡rio\",\"weight\":\"Bolder\",\"size\":\"Medium\"},{\"type\":\"TextBlock\",\"text\":\"Atualize o status do seu projeto\",\"isSubtle\":true,\"spacing\":\"None\"}]}]},{\"type\":\"TextBlock\",\"text\":\"Projeto: **${ProjectName}**\",\"wrap\":true},{\"type\":\"Input.ChoiceSet\",\"id\":\"statusRAG\",\"label\":\"ðŸš¦ Status (RAG)\",\"isRequired\":true,\"choices\":[{\"title\":\"ðŸŸ¢ Verde â€” No prazo\",\"value\":\"Verde\"},{\"title\":\"ðŸŸ¡ Amarelo â€” AtenÃ§Ã£o\",\"value\":\"Amarelo\"},{\"title\":\"ðŸ”´ Vermelho â€” CrÃ­tico\",\"value\":\"Vermelho\"}]},{\"type\":\"Input.Text\",\"id\":\"resumo\",\"label\":\"ðŸ“ Resumo do status\",\"isRequired\":true,\"isMultiline\":true,\"placeholder\":\"Descreva o progresso atual...\"},{\"type\":\"Input.Number\",\"id\":\"percentual\",\"label\":\"ðŸ“ˆ Percentual concluÃ­do\",\"min\":0,\"max\":100,\"placeholder\":\"0-100\"},{\"type\":\"Input.Text\",\"id\":\"risco\",\"label\":\"âš ï¸ Riscos (opcional)\",\"isMultiline\":true,\"placeholder\":\"Descreva riscos atuais...\"},{\"type\":\"Input.Text\",\"id\":\"bloqueio\",\"label\":\"ðŸš« Bloqueios (opcional)\",\"isMultiline\":true,\"placeholder\":\"Descreva bloqueios atuais...\"},{\"type\":\"Input.Text\",\"id\":\"proximaAcao\",\"label\":\"âž¡ï¸ PrÃ³xima aÃ§Ã£o\",\"isMultiline\":true,\"placeholder\":\"O que serÃ¡ feito a seguir...\"}],\"actions\":[{\"type\":\"Action.Submit\",\"title\":\"âœ… Enviar Check-in\",\"data\":{\"action\":\"submitCheckIn\",\"projectId\":\"${ProjectID}\",\"cardVersion\":\"1.0\",\"origemEntrada\":\"AdaptiveCard\"}}]}', '${ProjectName}', coalesce(first(body('Get_Projeto')?['value'])?['NomeProjeto'], first(body('Get_Projeto')?['value'])?['Title'], triggerBody()?['ProjectID'])), '${ProjectID}', triggerBody()?['ProjectID'])",
              "location": "Channel"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "connectionName": "shared_teams",
              "operationId": "PostCardAndWaitForResponse"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Normalize_RAG": {
          "runAfter": {
            "Post_CheckIn_Wait_Response": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['statusRAG'], body('Post_CheckIn_Wait_Response')?['statusRAG'], 'Verde')"
        },
        "Normalize_Resumo": {
          "runAfter": {
            "Normalize_RAG": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['resumo'], body('Post_CheckIn_Wait_Response')?['resumo'], 'Sem resumo informado')"
        },
        "Normalize_Percentual": {
          "runAfter": {
            "Normalize_Resumo": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['percentual'], body('Post_CheckIn_Wait_Response')?['percentual'], 0)"
        },
        "Normalize_Risco": {
          "runAfter": {
            "Normalize_Percentual": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['risco'], body('Post_CheckIn_Wait_Response')?['risco'], '')"
        },
        "Normalize_Bloqueio": {
          "runAfter": {
            "Normalize_Risco": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['bloqueio'], body('Post_CheckIn_Wait_Response')?['bloqueio'], '')"
        },
        "Normalize_ProximaAcao": {
          "runAfter": {
            "Normalize_Bloqueio": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(body('Post_CheckIn_Wait_Response')?['data']?['proximaAcao'], body('Post_CheckIn_Wait_Response')?['proximaAcao'], '')"
        },
        "Create_Status_Diario": {
          "runAfter": {
            "Normalize_ProximaAcao": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "item/Percentual": "@if(empty(string(outputs('Normalize_Percentual'))), 0, int(outputs('Normalize_Percentual')))",
              "item/StatusID": "@concat('ST-', ticks(utcNow()))",
              "item/CardVersion": "1.0",
              "item/Title": "@concat('STATUS-', ticks(utcNow()))",
              "item/OrigemEntrada/Value": "AdaptiveCard",
              "item/Bloqueio": "@outputs('Normalize_Bloqueio')",
              "item/ProjectID": "@triggerBody()?['ProjectID']",
              "item/DataRegistro": "@utcNow()",
              "item/ProximaAcao": "@outputs('Normalize_ProximaAcao')",
              "item/RAG/Value": "@outputs('Normalize_RAG')",
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/Resumo": "@outputs('Normalize_Resumo')",
              "table": "Status Diario",
              "item/Risco": "@outputs('Normalize_Risco')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Apply_to_each_Projeto": {
          "foreach": "@body('Get_Projeto')?['value']",
          "actions": {
            "Update_Projeto": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "id": "@items('Apply_to_each_Projeto')?['ID']",
                  "item/Title": "@items('Apply_to_each_Projeto')?['Title']",
                  "item/Percentual": "@if(empty(string(outputs('Normalize_Percentual'))), 0, int(outputs('Normalize_Percentual')))",
                  "item/NomeProjeto": "@items('Apply_to_each_Projeto')?['NomeProjeto']",
                  "table": "Projetos",
                  "item/ProjectID": "@items('Apply_to_each_Projeto')?['ProjectID']",
                  "item/UltimaAtualizacao": "@utcNow()",
                  "item/StatusRAG/Value": "@outputs('Normalize_RAG')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "authentication": {
                  "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                  "type": "Raw"
                }
              }
            }
          },
          "runAfter": {
            "Create_Status_Diario": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        },
        "Response_OK": {
          "runAfter": {
            "Apply_to_each_Projeto": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "success": true,
              "message": "Check-in response captured and written to SharePoint.",
              "projectId": "@{triggerBody()?['ProjectID']}",
              "statusRAG": "@{outputs('Normalize_RAG')}"
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}