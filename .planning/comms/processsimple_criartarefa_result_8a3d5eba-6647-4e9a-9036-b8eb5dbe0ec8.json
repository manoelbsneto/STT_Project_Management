{
  "name": "7ca90102-525b-48bb-875e-0f7bda96f85b",
  "id": "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/7ca90102-525b-48bb-875e-0f7bda96f85b",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "PMO_PA_CriarTarefa",
    "userType": "Owner",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Copilot_CriarTarefa_Request": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "nomeProjeto": {
                  "type": "string",
                  "description": "Nome do projeto (fornecido pelo PM)"
                },
                "titulo": {
                  "type": "string",
                  "description": "Titulo da tarefa/projeto"
                },
                "responsavel": {
                  "type": "string",
                  "description": "Nome do responsavel"
                },
                "prazo": {
                  "type": "string",
                  "description": "Data alvo no formato ISO 8601 ou dd/MM/yyyy"
                },
                "horas": {
                  "type": "integer",
                  "description": "Horas estimadas"
                },
                "prioridade": {
                  "type": "string",
                  "description": "Prioridade: Alta, Media, Baixa ou Critica"
                }
              },
              "required": [
                "titulo",
                "responsavel",
                "prazo",
                "prioridade"
              ]
            }
          }
        }
      },
      "actions": {
        "Create_Projeto_SharePoint": {
          "runAfter": {
            "Compose_NomeProjeto": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "item/DataAlvo": "@triggerBody()?['prazo']",
              "item/ProjectID": "@outputs('Compose_New_ProjectID')",
              "item/Percentual": 0,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "item/Title": "@outputs('Compose_NomeProjeto')",
              "item/UltimaAtualizacao": "@utcNow()",
              "item/NomeProjeto": "@outputs('Compose_NomeProjeto')",
              "item/ResumoExecutivo": "@concat('Projeto criado via Copilot Studio. Titulo: ', coalesce(triggerBody()?['titulo'], '-'), '. Horas estimadas: ', coalesce(string(triggerBody()?['horas']), 'N/A'), 'h. Responsavel: ', coalesce(triggerBody()?['responsavel'], '-'), '. Prazo: ', coalesce(triggerBody()?['prazo'], '-'), '.')",
              "item/Ativo": true,
              "item/Prioridade/Value": "@outputs('Map_Prioridade')",
              "table": "Projetos",
              "item/StatusRAG/Value": "Verde"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Compose_New_ProjectID": {
          "runAfter": {
            "Get_Existing_Projects": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(length(body('Get_Existing_Projects')?['value']), 0), 'PRJ-000001', concat('PRJ-', padLeft(string(add(int(last(split(coalesce(first(body('Get_Existing_Projects')?['value'])?['ProjectID'], 'PRJ-0'), '-'))), 1)), 6, '0')))"
        },
        "Map_Prioridade": {
          "runAfter": {
            "Compose_New_ProjectID": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(or(equals(triggerBody()?['prioridade'], 'Critica'), equals(triggerBody()?['prioridade'], 'Crítica')), 'Alta', coalesce(triggerBody()?['prioridade'], 'Media'))"
        },
        "Response_Success": {
          "runAfter": {
            "Create_Projeto_SharePoint": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "success": true,
              "message": "@{concat('Projeto ', outputs('Compose_NomeProjeto'), ' criado com codigo ', outputs('Compose_New_ProjectID'), '.')}",
              "projectId": "@{outputs('Compose_New_ProjectID')}"
            }
          }
        },
        "Compose_NomeProjeto": {
          "runAfter": {
            "Map_Prioridade": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(triggerBody()?['nomeProjeto'], triggerBody()?['titulo'], 'Sem nome')"
        },
        "Get_Existing_Projects": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "$top": 1,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos",
              "$orderby": "ID desc"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Response_Error": {
          "runAfter": {
            "Create_Projeto_SharePoint": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 500,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "success": false,
              "message": "Erro ao criar projeto no SharePoint.",
              "errorcode": "SP_CREATE_FAILED"
            }
          }
        }
      },
      "outputs": {}
    },
    "triggerSchema": {
      "type": "object",
      "properties": {
        "nomeProjeto": {
          "type": "string",
          "description": "Nome do projeto (fornecido pelo PM)"
        },
        "titulo": {
          "type": "string",
          "description": "Titulo da tarefa/projeto"
        },
        "responsavel": {
          "type": "string",
          "description": "Nome do responsavel"
        },
        "prazo": {
          "type": "string",
          "description": "Data alvo no formato ISO 8601 ou dd/MM/yyyy"
        },
        "horas": {
          "type": "integer",
          "description": "Horas estimadas"
        },
        "prioridade": {
          "type": "string",
          "description": "Prioridade: Alta, Media, Baixa ou Critica"
        }
      },
      "required": [
        "titulo",
        "responsavel",
        "prazo",
        "prioridade"
      ]
    },
    "state": "Started",
    "connectionReferences": {
      "shared_sharepointonline": {
