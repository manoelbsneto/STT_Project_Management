    "actions":  {
                    "Get_Projetos_Ativos":  {
                                                "runAfter":  {

                                                             },
                                                "type":  "OpenApiConnection",
                                                "inputs":  {
                                                               "parameters":  {
                                                                                  "$filter":  "Ativo eq 1",
                                                                                  "table":  "Projetos",
                                                                                  "$top":  200,
                                                                                  "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
                                                                              },
                                                               "host":  {
                                                                            "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                            "connectionName":  "shared_sharepointonline",
                                                                            "operationId":  "GetItems"
                                                                        },
                                                               "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                           }
                                            },
                    "Filter_Verdes":  {
                                          "runAfter":  {
                                                           "Get_Projetos_Ativos":  [
                                                                                       "Succeeded"
                                                                                   ]
                                                       },
                                          "type":  "Query",
                                          "inputs":  {
                                                         "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                         "where":  "@equals(coalesce(item()?[\u0027StatusRAG\u0027]?[\u0027Value\u0027], item()?[\u0027StatusRAG\u0027]), \u0027Verde\u0027)"
                                                     }
                                      },
                    "Filter_Amarelos":  {
                                            "runAfter":  {
                                                             "Filter_Verdes":  [
                                                                                   "Succeeded"
                                                                               ]
                                                         },
                                            "type":  "Query",
                                            "inputs":  {
                                                           "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                           "where":  "@equals(coalesce(item()?[\u0027StatusRAG\u0027]?[\u0027Value\u0027], item()?[\u0027StatusRAG\u0027]), \u0027Amarelo\u0027)"
                                                       }
                                        },
                    "Filter_Vermelhos":  {
                                             "runAfter":  {
                                                              "Filter_Amarelos":  [
                                                                                      "Succeeded"
                                                                                  ]
                                                          },
                                             "type":  "Query",
                                             "inputs":  {
                                                            "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                            "where":  "@equals(coalesce(item()?[\u0027StatusRAG\u0027]?[\u0027Value\u0027], item()?[\u0027StatusRAG\u0027]), \u0027Vermelho\u0027)"
                                                        }
                                         },
                    "Filter_Projetos_Sem_Update":  {
                                                       "runAfter":  {
                                                                        "Filter_Vermelhos":  [
                                                                                                 "Succeeded"
                                                                                             ]
                                                                    },
                                                       "type":  "Query",
                                                       "inputs":  {
                                                                      "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                                      "where":  "@lessOrEquals(coalesce(item()?[\u0027UltimaAtualizacao\u0027], \u00271900-01-01T00:00:00Z\u0027), addDays(utcNow(), -1))"
                                                                  }
                                                   },
                    "Select_Projetos_Sem_Update":  {
                                                       "runAfter":  {
                                                                        "Filter_Projetos_Sem_Update":  [
                                                                                                           "Succeeded"
                                                                                                       ]
                                                                    },
                                                       "type":  "Select",
                                                       "inputs":  {
                                                                      "from":  "@body(\u0027Filter_Projetos_Sem_Update\u0027)",
                                                                      "select":  "@concat(\u0027- \u0027, item()?[\u0027ProjectID\u0027], \u0027 | \u0027, coalesce(item()?[\u0027NomeProjeto\u0027], item()?[\u0027Title\u0027], \u0027-\u0027), \u0027 | Ultima: \u0027, coalesce(string(item()?[\u0027UltimaAtualizacao\u0027]), \u0027-\u0027))"
                                                                  }
                                                   },
                    "Compose_Projetos_Sem_Update":  {
                                                        "runAfter":  {
                                                                         "Select_Projetos_Sem_Update":  [
                                                                                                            "Succeeded"
                                                                                                        ]
                                                                     },
                                                        "type":  "Compose",
                                                        "inputs":  "@if(equals(length(body(\u0027Select_Projetos_Sem_Update\u0027)), 0), \u0027Nenhum projeto atrasado no check-in.\u0027, join(body(\u0027Select_Projetos_Sem_Update\u0027), \u0027\\n\u0027))"
                                                    },
                    "Get_Decisoes":  {
                                         "runAfter":  {
                                                          "Compose_Projetos_Sem_Update":  [
                                                                                              "Succeeded"
                                                                                          ]
                                                      },
                                         "type":  "OpenApiConnection",
                                         "inputs":  {
                                                        "parameters":  {
                                                                           "$filter":  "StatusDecisao eq \u0027Pendente\u0027",
                                                                           "table":  "Decisoes do Board",
                                                                           "$top":  100,
                                                                           "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
                                                                       },
                                                        "host":  {
                                                                     "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                     "connectionName":  "shared_sharepointonline",
                                                                     "operationId":  "GetItems"
                                                                 },
                                                        "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                    }
                                     },
                    "Select_Decisoes":  {
                                            "runAfter":  {
                                                             "Get_Decisoes":  [
                                                                                  "Succeeded"
                                                                              ]
                                                         },
                                            "type":  "Select",
                                            "inputs":  {
                                                           "from":  "@body(\u0027Get_Decisoes\u0027)?[\u0027value\u0027]",
                                                           "select":  "@concat(\u0027- \u0027, item()?[\u0027DecisionID\u0027], \u0027 | \u0027, item()?[\u0027ProjectID\u0027], \u0027 | \u0027, coalesce(item()?[\u0027Descricao\u0027], \u0027-\u0027))"
                                                       }
                                        },
                    "Compose_Decisoes_Pendentes":  {
                                                       "runAfter":  {
                                                                        "Select_Decisoes":  [
                                                                                                "Succeeded"
                                                                                            ]
                                                                    },
                                                       "type":  "Compose",
                                                       "inputs":  "@if(equals(length(body(\u0027Select_Decisoes\u0027)), 0), \u0027Nenhuma decisao no criterio do resumo.\u0027, join(body(\u0027Select_Decisoes\u0027), \u0027\\n\u0027))"
                                                   },
                    "Count_Total":  {
                                        "runAfter":  {
                                                         "Compose_Decisoes_Pendentes":  [
                                                                                            "Succeeded"
                                                                                        ]
                                                     },
                                        "type":  "Compose",
                                        "inputs":  "@length(body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027])"
                                    },
                    "Count_Verdes":  {
                                         "runAfter":  {
                                                          "Count_Total":  [
                                                                              "Succeeded"
                                                                          ]
                                                      },
                                         "type":  "Compose",
                                         "inputs":  "@length(body(\u0027Filter_Verdes\u0027))"
                                     },
                    "Count_Amarelos":  {
                                           "runAfter":  {
                                                            "Count_Verdes":  [
                                                                                 "Succeeded"
                                                                             ]
