                                                     "inputs":  {
                                                                    "parameters":  {
                                                                                       "poster":  "Flow bot",
                                                                                       "body/messageBody":  "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(\u0027{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"emphasis\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Resumo Diario do Portfolio\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${DataReferencia}\",\"isSubtle\":true,\"spacing\":\"None\",\"wrap\":true}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Total\",\"isSubtle\":true,\"horizontalAlignment\":\"Center\"},{\"type\":\"TextBlock\",\"text\":\"${TotalProjetos}\",\"weight\":\"Bolder\",\"size\":\"Large\",\"horizontalAlignment\":\"Center\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Verde\",\"isSubtle\":true,\"horizontalAlignment\":\"Center\"},{\"type\":\"TextBlock\",\"text\":\"${Verdes}\",\"weight\":\"Bolder\",\"size\":\"Large\",\"color\":\"Good\",\"horizontalAlignment\":\"Center\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Amarelo\",\"isSubtle\":true,\"horizontalAlignment\":\"Center\"},{\"type\":\"TextBlock\",\"text\":\"${Amarelos}\",\"weight\":\"Bolder\",\"size\":\"Large\",\"color\":\"Warning\",\"horizontalAlignment\":\"Center\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Vermelho\",\"isSubtle\":true,\"horizontalAlignment\":\"Center\"},{\"type\":\"TextBlock\",\"text\":\"${Vermelhos}\",\"weight\":\"Bolder\",\"size\":\"Large\",\"color\":\"Attention\",\"horizontalAlignment\":\"Center\"}]}]},{\"type\":\"TextBlock\",\"text\":\"Sem atualizacao ha mais de 24h (${SemUpdateCount})\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${ProjetosSemUpdate}\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"Decisoes pendentes (${DecisoesPendentesCount})\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${DecisoesPendentes}\",\"wrap\":true}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"Abrir hub PMO\",\"url\":\"${HubUrl}\"}]}\u0027, \u0027${DataReferencia}\u0027, formatDateTime(convertTimeZone(utcNow(), \u0027UTC\u0027, \u0027E. South America Standard Time\u0027), \u0027dd/MM/yyyy HH:mm\u0027)), \u0027${TotalProjetos}\u0027, string(outputs(\u0027Count_Total\u0027))), \u0027${Verdes}\u0027, string(outputs(\u0027Count_Verdes\u0027))), \u0027${Amarelos}\u0027, string(outputs(\u0027Count_Amarelos\u0027))), \u0027${Vermelhos}\u0027, string(outputs(\u0027Count_Vermelhos\u0027))), \u0027${SemUpdateCount}\u0027, string(outputs(\u0027Count_Sem_Update\u0027))), \u0027${ProjetosSemUpdate}\u0027, outputs(\u0027Compose_Projetos_Sem_Update\u0027)), \u0027${DecisoesPendentesCount}\u0027, string(outputs(\u0027Count_Decisoes_Pendentes\u0027))), \u0027${DecisoesPendentes}\u0027, outputs(\u0027Compose_Decisoes_Pendentes\u0027)), \u0027${HubUrl}\u0027, \u0027https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital/Lists/Projetos/AllItems.aspx\u0027)",
                                                                                       "body/recipient/channelId":  "19:4c8fe80b169f4e698c9b1b15d1868691@thread.tacv2",
                                                                                       "location":  "Channel",
                                                                                       "body/recipient/groupId":  "96c5b0c4-46cc-46cd-8695-50451db74994"
                                                                                   },
                                                                    "host":  {
                                                                                 "apiId":  "/providers/Microsoft.PowerApps/apis/shared_teams",
                                                                                 "connectionName":  "shared_teams",
                                                                                 "operationId":  "PostCardToConversation"
                                                                             },
                                                                    "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                }
                                                 }
