                    "Count_Vermelhos":  {
                                            "runAfter":  {
                                                             "Count_Amarelos":  [
                                                                                    "Succeeded"
                                                                                ]
                                                         },
                                            "type":  "Compose",
                                            "inputs":  "@length(body(\u0027Filter_Vermelhos\u0027))"
                                        },
                    "Count_Sem_Update":  {
                                             "runAfter":  {
                                                              "Count_Vermelhos":  [
                                                                                      "Succeeded"
                                                                                  ]
