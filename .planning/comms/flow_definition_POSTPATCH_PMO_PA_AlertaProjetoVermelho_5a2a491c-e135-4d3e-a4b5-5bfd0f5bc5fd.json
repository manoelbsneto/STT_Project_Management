                                                                                                                                   "emailMessage/Body":  "\u003cp\u003eO projeto foi classificado como Vermelho e requer atencao imediata.\u003c/p\u003e\u003cp\u003e\u003cb\u003eProjectID:\u003c/b\u003e @{coalesce(body(\u0027Get_Projeto_Detalhes\u0027)?[\u0027ProjectID\u0027], triggerBody()?[\u0027ProjectID\u0027])}\u003c/p\u003e\u003cp\u003e\u003cb\u003ePercentual:\u003c/b\u003e @{coalesce(string(body(\u0027Get_Projeto_Detalhes\u0027)?[\u0027Percentual\u0027]), string(triggerBody()?[\u0027Percentual\u0027]), \u00270\u0027)}%\u003c/p\u003e",
                                                                                                                                   "emailMessage/Subject":  "ALERTA: Projeto @{coalesce(body(\u0027Get_Projeto_Detalhes\u0027)?[\u0027NomeProjeto\u0027], body(\u0027Get_Projeto_Detalhes\u0027)?[\u0027Nome\u0027], triggerBody()?[\u0027NomeProjeto\u0027], triggerBody()?[\u0027Nome\u0027], triggerBody()?[\u0027ProjectID\u0027])} em status Vermelho",
                                                                                                                                   "emailMessage/To":  "@coalesce(body(\u0027Get_Projeto_Detalhes\u0027)?[\u0027Sponsor\u0027]?[\u0027Email\u0027], triggerBody()?[\u0027Sponsor\u0027]?[\u0027Email\u0027], \u0027mbenicios@minsait.com\u0027)"
                                                                                                                               },
