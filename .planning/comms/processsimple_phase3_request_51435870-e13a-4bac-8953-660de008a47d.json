{
    "name":  "51435870-e13a-4bac-8953-660de008a47d",
    "type":  "Microsoft.ProcessSimple/environments/flows",
    "id":  "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/51435870-e13a-4bac-8953-660de008a47d",
    "properties":  {
                       "apiId":  "/providers/Microsoft.PowerApps/apis/shared_logicflows",
                       "displayName":  "PMO_PA_SyncPlannerStats_Standard",
                       "definition":  {
                                          "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                                          "contentVersion":  "1.0.0.0",
                                          "parameters":  {
                                                             "$connections":  {
                                                                                  "defaultValue":  {

                                                                                                   },
                                                                                  "type":  "Object"
                                                                              },
                                                             "$authentication":  {
                                                                                     "defaultValue":  {

                                                                                                      },
                                                                                     "type":  "SecureObject"
                                                                                 }
                                                         },
                                          "triggers":  {
                                                           "Recurrence_Every_6h":  {
                                                                                       "recurrence":  {
                                                                                                          "frequency":  "Hour",
                                                                                                          "interval":  6
                                                                                                      },
                                                                                       "type":  "Recurrence"
                                                                                   }
                                                       },
                                          "actions":  {
                                                          "Get_Projetos_Ativos":  {
                                                                                      "type":  "OpenApiConnection",
                                                                                      "inputs":  {
                                                                                                     "parameters":  {
                                                                                                                        "$filter":  "Ativo eq 1",
                                                                                                                        "table":  "Projetos",
                                                                                                                        "$top":  200,
                                                                                                                        "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
                                                                                                                    },
                                                                                                     "host":  {
                                                                                                                  "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                                                  "connectionName":  "shared_sharepointonline",
                                                                                                                  "operationId":  "GetItems"
                                                                                                              },
                                                                                                     "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                 },
                                                                                      "runAfter":  {

                                                                                                   }
                                                                                  },
                                                          "Filter_Projetos_Com_Planner":  {
                                                                                              "type":  "Query",
                                                                                              "inputs":  {
                                                                                                             "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                                                                             "where":  "@and(not(empty(item()?[\u0027PlannerPlanId\u0027])), not(empty(item()?[\u0027PlannerGroupId\u0027])))"
                                                                                                         },
                                                                                              "runAfter":  {
                                                                                                               "Get_Projetos_Ativos":  [
                                                                                                                                           "Succeeded"
                                                                                                                                       ]
                                                                                                           }
                                                                                          },
                                                          "Apply_to_each_Projeto_Planner":  {
                                                                                                "type":  "Foreach",
                                                                                                "foreach":  "@body(\u0027Filter_Projetos_Com_Planner\u0027)",
                                                                                                "runtimeConfiguration":  {
                                                                                                                             "concurrency":  {
                                                                                                                                                 "repetitions":  1
                                                                                                                                             }
                                                                                                                         },
                                                                                                "actions":  {
                                                                                                                "List_Planner_Tasks":  {
                                                                                                                                           "type":  "OpenApiConnection",
                                                                                                                                           "inputs":  {
                                                                                                                                                          "parameters":  {
                                                                                                                                                                             "id":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027PlannerPlanId\u0027]",
                                                                                                                                                                             "groupId":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027PlannerGroupId\u0027]"
                                                                                                                                                                         },
                                                                                                                                                          "host":  {
                                                                                                                                                                       "apiId":  "/providers/Microsoft.PowerApps/apis/shared_planner",
                                                                                                                                                                       "connectionName":  "shared_planner",
                                                                                                                                                                       "operationId":  "ListTasks_V3"
                                                                                                                                                                   },
                                                                                                                                                          "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                                                                      },
                                                                                                                                           "runAfter":  {

                                                                                                                                                        }
                                                                                                                                       },
                                                                                                                "Filter_Tarefas_Concluidas":  {
                                                                                                                                                  "type":  "Query",
                                                                                                                                                  "inputs":  {
                                                                                                                                                                 "from":  "@body(\u0027List_Planner_Tasks\u0027)?[\u0027value\u0027]",
                                                                                                                                                                 "where":  "@equals(coalesce(item()?[\u0027percentComplete\u0027], 0), 100)"
                                                                                                                                                             },
                                                                                                                                                  "runAfter":  {
                                                                                                                                                                   "List_Planner_Tasks":  [
                                                                                                                                                                                              "Succeeded"
                                                                                                                                                                                          ]
                                                                                                                                                               }
                                                                                                                                              },
                                                                                                                "Filter_Tarefas_Abertas":  {
                                                                                                                                               "type":  "Query",
                                                                                                                                               "inputs":  {
                                                                                                                                                              "from":  "@body(\u0027List_Planner_Tasks\u0027)?[\u0027value\u0027]",
                                                                                                                                                              "where":  "@not(equals(coalesce(item()?[\u0027percentComplete\u0027], 0), 100))"
                                                                                                                                                          },
                                                                                                                                               "runAfter":  {
                                                                                                                                                                "Filter_Tarefas_Concluidas":  [
                                                                                                                                                                                                  "Succeeded"
                                                                                                                                                                                              ]
                                                                                                                                                            }
                                                                                                                                           },
                                                                                                                "Filter_Tarefas_Atrasadas":  {
                                                                                                                                                 "type":  "Query",
                                                                                                                                                 "inputs":  {
                                                                                                                                                                "from":  "@body(\u0027Filter_Tarefas_Abertas\u0027)",
                                                                                                                                                                "where":  "@and(not(empty(item()?[\u0027dueDateTime\u0027])), less(item()?[\u0027dueDateTime\u0027], utcNow()))"
                                                                                                                                                            },
                                                                                                                                                 "runAfter":  {
                                                                                                                                                                  "Filter_Tarefas_Abertas":  [
                                                                                                                                                                                                 "Succeeded"
                                                                                                                                                                                             ]
                                                                                                                                                              }
                                                                                                                                             },
                                                                                                                "Update_Projeto_Planner_OK":  {
                                                                                                                                                  "type":  "OpenApiConnection",
                                                                                                                                                  "inputs":  {
                                                                                                                                                                 "parameters":  {
                                                                                                                                                                                    "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                                                                                                                                                                                    "item/TarefasTotal":  "@length(body(\u0027List_Planner_Tasks\u0027)?[\u0027value\u0027])",
                                                                                                                                                                                    "id":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027ID\u0027]",
                                                                                                                                                                                    "item/Title":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027Title\u0027]",
                                                                                                                                                                                    "item/PlannerSyncStatus/Value":  "OK",
                                                                                                                                                                                    "item/TarefasAtrasadas":  "@length(body(\u0027Filter_Tarefas_Atrasadas\u0027))",
                                                                                                                                                                                    "item/NomeProjeto":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027NomeProjeto\u0027]",
                                                                                                                                                                                    "table":  "Projetos",
                                                                                                                                                                                    "item/TarefasAbertas":  "@length(body(\u0027Filter_Tarefas_Abertas\u0027))",
                                                                                                                                                                                    "item/TarefasConcluidas":  "@length(body(\u0027Filter_Tarefas_Concluidas\u0027))",
                                                                                                                                                                                    "item/PlannerLastSyncAt":  "@utcNow()",
                                                                                                                                                                                    "item/ProjectID":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027ProjectID\u0027]"
                                                                                                                                                                                },
                                                                                                                                                                 "host":  {
                                                                                                                                                                              "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                                                                                                              "connectionName":  "shared_sharepointonline",
                                                                                                                                                                              "operationId":  "PatchItem"
                                                                                                                                                                          },
                                                                                                                                                                 "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                                                                             },
                                                                                                                                                  "runAfter":  {
                                                                                                                                                                   "Filter_Tarefas_Atrasadas":  [
                                                                                                                                                                                                    "Succeeded"
                                                                                                                                                                                                ]
                                                                                                                                                               }
                                                                                                                                              },
                                                                                                                "Update_Projeto_Planner_Erro":  {
                                                                                                                                                    "type":  "OpenApiConnection",
                                                                                                                                                    "inputs":  {
                                                                                                                                                                   "parameters":  {
                                                                                                                                                                                      "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                                                                                                                                                                                      "id":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027ID\u0027]",
                                                                                                                                                                                      "item/Title":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027Title\u0027]",
                                                                                                                                                                                      "item/PlannerSyncStatus/Value":  "Erro",
                                                                                                                                                                                      "item/NomeProjeto":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027NomeProjeto\u0027]",
                                                                                                                                                                                      "table":  "Projetos",
                                                                                                                                                                                      "item/ProjectID":  "@items(\u0027Apply_to_each_Projeto_Planner\u0027)?[\u0027ProjectID\u0027]",
                                                                                                                                                                                      "item/PlannerLastSyncAt":  "@utcNow()"
                                                                                                                                                                                  },
                                                                                                                                                                   "host":  {
                                                                                                                                                                                "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                                                                                                                                "connectionName":  "shared_sharepointonline",
                                                                                                                                                                                "operationId":  "PatchItem"
                                                                                                                                                                            },
                                                                                                                                                                   "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                                                                               },
                                                                                                                                                    "runAfter":  {
                                                                                                                                                                     "List_Planner_Tasks":  [
                                                                                                                                                                                                "Failed",
                                                                                                                                                                                                "TimedOut"
                                                                                                                                                                                            ]
                                                                                                                                                                 }
                                                                                                                                                }
                                                                                                            },
                                                                                                "runAfter":  {
                                                                                                                 "Filter_Projetos_Com_Planner":  [
                                                                                                                                                     "Succeeded"
                                                                                                                                                 ]
                                                                                                             }
                                                                                            }
                                                      },
                                          "outputs":  {

                                                      }
                                      },
                       "connectionReferences":  {
