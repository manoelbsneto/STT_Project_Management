{
  "name": "aee885f8-5947-41a6-a04b-1d46bd7e7746",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "id": "/providers/Microsoft.ProcessSimple/environments/e2d10003-4d8e-e007-9d63-76d5fe89ef56/flows/aee885f8-5947-41a6-a04b-1d46bd7e7746",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "PMO_PA_RegistrarBloqueioBot",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Copilot_Request": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "impacto": {
                  "type": "string",
                  "description": "Impacto"
                },
                "projectName": {
                  "type": "string",
                  "description": "Nome do projeto"
                },
                "descricao": {
                  "type": "string",
                  "description": "Descricao do bloqueio"
                }
              },
              "required": [
                "projectName",
                "descricao",
                "impacto"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_Projeto": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "table": "Projetos",
              "$filter": "NomeProjeto eq '@{replace(outputs('Compose_ProjectName'),'''','''''')}' and Ativo eq 1 and Deleted eq 0",
              "$top": 1,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Compose_ProjectName": [
              "Succeeded"
            ]
          }
        },
        "Map_Impacto": {
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'cr'), 'Critico', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'a'), 'Alto', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'm'), 'Medio', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'b'), 'Baixo', 'Medio'))))",
          "runAfter": {
            "Get_Projeto": [
              "Succeeded"
            ]
          }
        },
        "Map_Severidade": {
          "type": "Compose",
          "inputs": "@if(equals(outputs('Map_Impacto'), 'Critico'), 'Critica', if(equals(outputs('Map_Impacto'), 'Alto'), 'Alta', if(equals(outputs('Map_Impacto'), 'Baixo'), 'Baixa', 'Media')))",
          "runAfter": {
            "Map_Impacto": [
              "Succeeded"
            ]
          }
        },
        "Condition_Projeto_Encontrado": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('Get_Projeto')?['value'])",
              0
            ]
          },
          "actions": {
            "Create_Bloqueio_SharePoint": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "item/Deleted": false,
                  "item/ProjectID": "@body('Get_Projeto')?['value']?[0]?['ProjectID']",
                  "item/Impacto/Value": "@outputs('Map_Impacto')",
                  "table": "Riscos e Bloqueios",
                  "item/DataCriacao": "@utcNow()",
                  "item/Tipo/Value": "Bloqueio",
                  "item/Title": "@outputs('Compose_RiskID')",
                  "item/Descricao": "@triggerBody()?['descricao']",
                  "item/StatusRisco/Value": "Aberto",
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "item/RiskID": "@outputs('Compose_RiskID')",
                  "item/Severidade/Value": "@outputs('Map_Severidade')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "PostItem",
                  "connectionName": "shared_sharepointonline"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Response_OK": {
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "@{concat('Bloqueio ', outputs('Compose_RiskID'), ' registrado para projeto ', outputs('Compose_ProjectName'), '. Impacto: ', outputs('Map_Impacto'), '.')}"
                }
              },
              "runAfter": {
                "Create_Bloqueio_SharePoint": [
                  "Succeeded"
                ]
              }
            },
            "Response_Error_Write": {
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "Erro ao registrar bloqueio no SharePoint. Codigo: SP_WRITE_FAILED."
                }
              },
              "runAfter": {
                "Create_Bloqueio_SharePoint": [
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Response_Project_Not_Found": {
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "message": "Projeto nao encontrado. Codigo: PROJECT_NOT_FOUND."
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {
            "Compose_RiskID": [
              "Succeeded"
            ]
          }
        },
        "Compose_ProjectName": {
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))",
          "runAfter": {}
        },
        "Compose_RiskID": {
          "type": "Compose",
          "inputs": "@concat('BLOCK-', toUpper(substring(guid(), 0, 8)))",
          "runAfter": {
            "Map_Severidade": [
              "Succeeded"
            ]
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "44f187cde7f54f208cf22bac4e533816",
        "connectionReferenceLogicalName": "pmo_sharepoint",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "displayName": "SharePoint",
        "tier": "Standard",
        "apiName": "sharepointonline",
        "isProcessSimpleApiReferenceConversionAlreadyDone": false
      }
    },
    "flowOpenAiData": {
      "isConsequential": false,
      "isConsequentialFlagOverwritten": false
    }
  }
}
