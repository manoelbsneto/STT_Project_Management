{
    "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion":  "1.0.0.0",
    "parameters":  {
                       "$authentication":  {
                                               "defaultValue":  {

                                                                },
                                               "type":  "SecureObject"
                                           },
                       "$connections":  {
                                            "defaultValue":  {

                                                             },
                                            "type":  "Object"
                                        }
                   },
    "triggers":  {
                     "Recurrence_10h_BRT":  {
                                                "recurrence":  {
                                                                   "frequency":  "Day",
                                                                   "interval":  1,
                                                                   "timeZone":  "E. South America Standard Time",
                                                                   "schedule":  {
                                                                                    "hours":  [
                                                                                                  10
                                                                                              ],
                                                                                    "minutes":  [
                                                                                                    0
                                                                                                ]
                                                                                }
                                                               },
                                                "evaluatedRecurrence":  {
                                                                            "frequency":  "Day",
                                                                            "interval":  1,
                                                                            "timeZone":  "E. South America Standard Time",
                                                                            "schedule":  {
                                                                                             "hours":  [
                                                                                                           10
                                                                                                       ],
                                                                                             "minutes":  [
                                                                                                             0
                                                                                                         ]
                                                                                         }
                                                                        },
                                                "type":  "Recurrence"
                                            }
                 },
    "actions":  {
                    "Filter_Sem_Update":  {
                                              "runAfter":  {
                                                               "Get_Projetos_Ativos":  [
                                                                                           "Succeeded"
                                                                                       ]
                                                           },
                                              "type":  "Query",
                                              "inputs":  {
                                                             "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                             "where":  "@lessOrEquals(coalesce(item()?[\u0027UltimaAtualizacao\u0027], \u00271900-01-01T00:00:00Z\u0027), addDays(utcNow(), -1))"
                                                         }
                                          },
                    "Get_Projetos_Ativos":  {
                                                "runAfter":  {

                                                             },
                                                "type":  "OpenApiConnection",
                                                "inputs":  {
                                                               "parameters":  {
                                                                                  "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                                                                                  "table":  "Projetos",
                                                                                  "$top":  100,
                                                                                  "$filter":  "Ativo eq 1"
                                                                              },
                                                               "host":  {
                                                                            "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                            "connectionName":  "shared_sharepointonline",
                                                                            "operationId":  "GetItems"
                                                                        },
                                                               "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                           }
                                            },
                    "Apply_to_each_Sem_Update":  {
                                                     "foreach":  "@body(\u0027Filter_Sem_Update\u0027)",
                                                     "actions":  {
                                                                     "Post_Reminder_Channel":  {
                                                                                                   "runAfter":  {

                                                                                                                },
                                                                                                   "type":  "OpenApiConnection",
                                                                                                   "inputs":  {
                                                                                                                  "parameters":  {
                                                                                                                                     "body/recipient/groupId":  "96c5b0c4-46cc-46cd-8695-50451db74994",
                                                                                                                                     "body/messageBody":  "\u003cp\u003ePMO reminder: project without update in the last 24h. Check the Projetos list.\u003c/p\u003e",
                                                                                                                                     "location":  "Channel",
                                                                                                                                     "body/recipient/channelId":  "19:4c8fe80b169f4e698c9b1b15d1868691@thread.tacv2",
                                                                                                                                     "poster":  "Flow bot"
                                                                                                                                 },
                                                                                                                  "host":  {
                                                                                                                               "apiId":  "/providers/Microsoft.PowerApps/apis/shared_teams",
                                                                                                                               "connectionName":  "shared_teams",
                                                                                                                               "operationId":  "PostMessageToConversation"
                                                                                                                           },
                                                                                                                  "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                              }
                                                                                               }
                                                                 },
                                                     "runAfter":  {
                                                                      "Filter_Sem_Update":  [
                                                                                                "Succeeded"
                                                                                            ]
                                                                  },
                                                     "type":  "Foreach"
                                                 }
                },
    "outputs":  {

                }
}
