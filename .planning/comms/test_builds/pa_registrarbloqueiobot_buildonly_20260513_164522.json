                                                           }
                                      },
                       "triggers":  {
                                        "Copilot_Request":  {
                                                                "type":  "Request",
                                                                "kind":  "Skills",
                                                                "inputs":  {
                                                                               "schema":  {
                                                                                              "type":  "object",
                                                                                              "properties":  {
                                                                                                                 "descricao":  {
                                                                                                                                   "type":  "string",
                                                                                                                                   "description":  "Descricao do bloqueio"
                                                                                                                               },
                                                                                                                 "projectName":  {
                                                                                                                                     "type":  "string",
                                                                                                                                     "description":  "Nome do projeto"
                                                                                                                                 },
                                                                                                                 "impacto":  {
                                                                                                                                 "type":  "string",
                                                                                                                                 "description":  "Impacto"
                                                                                                                             }
                                                                                                             },
                                                                                              "required":  [
                                                                                                               "projectName",
                                                                                                               "descricao",
                                                                                                               "impacto"
                                                                                                           ]
