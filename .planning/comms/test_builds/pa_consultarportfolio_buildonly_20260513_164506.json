                                                                                                                                                 },
                                                                                                                                                 {
                                                                                                                                                     "less":  [
                                                                                                                                                                  "@ticks(item()?[\u0027UltimaAtualizacao\u0027])",
                                                                                                                                                                  "@ticks(addDays(utcNow(), -1))"
                                                                                                                                                              ]
                                                                                                                                                 }
                                                                                                                                             ]
                                                                                                                                 },
                                                                                                                  "actions":  {
