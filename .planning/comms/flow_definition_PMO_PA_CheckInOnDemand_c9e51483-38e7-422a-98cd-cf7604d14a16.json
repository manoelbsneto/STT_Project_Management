{
    "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion":  "1.0.0.0",
    "parameters":  {
                       "$authentication":  {
                                               "defaultValue":  {

                                                                },
                                               "type":  "SecureObject"
                                           },
                       "$connections":  {
                                            "defaultValue":  {

                                                             },
                                            "type":  "Object"
                                        }
                   },
    "triggers":  {
                     "Manual_Copilot_Request":  {
                                                    "type":  "Request",
                                                    "kind":  "Skills",
                                                    "inputs":  {
                                                                   "schema":  {
                                                                                  "type":  "object",
                                                                                  "properties":  {
                                                                                                     "ProjectID":  {
                                                                                                                       "type":  "string",
                                                                                                                       "description":  "ProjectID to request immediate check-in"
                                                                                                                   }
                                                                                                 },
                                                                                  "required":  [
                                                                                                   "ProjectID"
                                                                                               ]
                                                                              }
                                                               }
                                                }
                 },
    "actions":  {
                    "Response_OK":  {
                                        "runAfter":  {
                                                         "Post_CheckIn_Message_Channel":  [
                                                                                              "Succeeded"
                                                                                          ]
                                                     },
                                        "type":  "Response",
                                        "kind":  "Skills",
                                        "inputs":  {
                                                       "statusCode":  200,
                                                       "headers":  {
                                                                       "Content-Type":  "application/json"
                                                                   },
                                                       "body":  {
                                                                    "success":  true,
                                                                    "message":  "Check-in card posted to Teams channel.",
                                                                    "projectId":  "@{triggerBody()?[\u0027ProjectID\u0027]}"
                                                                }
                                                   }
                                    },
                    "Get_Projeto":  {
                                        "runAfter":  {

                                                     },
                                        "type":  "OpenApiConnection",
                                        "inputs":  {
                                                       "parameters":  {
                                                                          "$filter":  "ProjectID eq \u0027@{triggerBody()?[\u0027ProjectID\u0027]}\u0027",
                                                                          "$top":  1,
                                                                          "table":  "Projetos",
                                                                          "dataset":  "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
                                                                      },
                                                       "host":  {
                                                                    "apiId":  "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                                                    "connectionName":  "shared_sharepointonline",
                                                                    "operationId":  "GetItems"
                                                                },
                                                       "authentication":  {
                                                                              "value":  "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
                                                                              "type":  "Raw"
                                                                          }
                                                   }
                                    },
                    "Post_CheckIn_Message_Channel":  {
                                                         "runAfter":  {
                                                                          "Get_Projeto":  [
                                                                                              "Succeeded"
                                                                                          ]
                                                                      },
                                                         "type":  "OpenApiConnection",
                                                         "inputs":  {
                                                                        "parameters":  {
                                                                                           "body/recipient/channelId":  "19:4c8fe80b169f4e698c9b1b15d1868691@thread.tacv2",
                                                                                           "poster":  "Flow bot",
                                                                                           "location":  "Channel",
                                                                                           "body/messageBody":  "\u003cp\u003e\u003cb\u003ePMO Check-in On Demand\u003c/b\u003e\u003c/p\u003e\u003cp\u003eCheck-in imediato solicitado. Use o Adaptive Card oficial em deploy/cards/CheckInDiario.json.\u003c/p\u003e",
                                                                                           "body/recipient/groupId":  "96c5b0c4-46cc-46cd-8695-50451db74994"
                                                                                       },
                                                                        "host":  {
                                                                                     "apiId":  "/providers/Microsoft.PowerApps/apis/shared_teams",
                                                                                     "connectionName":  "shared_teams",
                                                                                     "operationId":  "PostMessageToConversation"
                                                                                 },
                                                                        "authentication":  {
                                                                                               "value":  "@json(decodeBase64(triggerOutputs().headers[\u0027X-MS-APIM-Tokens\u0027]))[\u0027$ConnectionKey\u0027]",
                                                                                               "type":  "Raw"
                                                                                           }
                                                                    }
                                                     }
                },
    "outputs":  {

                }
}
