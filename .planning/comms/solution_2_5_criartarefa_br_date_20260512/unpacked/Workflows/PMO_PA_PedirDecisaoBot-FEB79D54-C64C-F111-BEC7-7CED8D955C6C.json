{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pmo_sharedsharepointonline_6e373"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aprovador": {
                  "type": "string",
                  "description": "UPN do aprovador",
                  "title": "aprovador",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "solicitante": {
                  "type": "string",
                  "description": "UPN do solicitante",
                  "title": "solicitante",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "descricao": {
                  "type": "string",
                  "description": "Descricao da decisao",
                  "title": "descricao",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "projectName": {
                  "type": "string",
                  "description": "Nome do projeto",
                  "title": "projectName",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "impacto": {
                  "type": "string",
                  "description": "Impacto",
                  "title": "impacto",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "prazo": {
                  "type": "string",
                  "description": "Prazo",
                  "title": "prazo",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "projectName",
                "descricao",
                "impacto",
                "prazo",
                "aprovador"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "35c9ed5d-51a3-4d58-a8ec-67896874331c"
          }
        }
      },
      "actions": {
        "Compose_Solicitante": {
          "runAfter": {
            "Compose_DecisionID": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(triggerBody()?['solicitante'], triggerBody()?['aprovador'])"
        },
        "Get_Projeto": {
          "runAfter": {
            "Compose_ProjectName": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "table": "Projetos",
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "$top": 1,
              "$filter": "NomeProjeto eq '@{replace(outputs('Compose_ProjectName'),'''','''''')}' and Ativo eq 1 and Deleted eq 0"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition_Projeto_Encontrado": {
          "actions": {
            "Create_Decisao_SharePoint": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "item/CardVersion": "1.0",
                  "item/Deleted": false,
                  "item/ApproverUPN": "@triggerBody()?['aprovador']",
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "item/Impacto/Value": "@outputs('Map_Impacto')",
                  "item/Aprovador/Claims": "@concat('i:0#.f|membership|', triggerBody()?['aprovador'])",
                  "item/Solicitante/Claims": "@concat('i:0#.f|membership|', outputs('Compose_Solicitante'))",
                  "item/DecisionID": "@outputs('Compose_DecisionID')",
                  "item/Descricao": "@triggerBody()?['descricao']",
                  "item/ResponseSource/Value": "CopilotStudio",
                  "item/Title": "@outputs('Compose_DecisionID')",
                  "table": "Decisoes do Board",
                  "item/ProjectID": "@body('Get_Projeto')?['value']?[0]?['ProjectID']",
                  "item/Prazo": "@outputs('Compose_Prazo')",
                  "item/StatusDecisao/Value": "Pendente"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Response_OK": {
              "runAfter": {
                "Create_Decisao_SharePoint": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "@{concat('Decisao ', outputs('Compose_DecisionID'), ' registrada para projeto ', outputs('Compose_ProjectName'), '.')}"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            },
            "Response_Error_Write": {
              "runAfter": {
                "Create_Decisao_SharePoint": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "Erro ao registrar decisao no SharePoint. Codigo: SP_WRITE_FAILED."
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Compose_Solicitante": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Response_Project_Not_Found": {
                "runAfter": {},
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "message": "Projeto nao encontrado. Codigo: PROJECT_NOT_FOUND."
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "title": "message",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "expression": {
            "greater": [
              "@length(body('Get_Projeto')?['value'])",
              0
            ]
          },
          "type": "If"
        },
        "Compose_Prazo": {
          "runAfter": {
            "Map_Impacto": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(or(empty(triggerBody()?['prazo']), not(contains(string(triggerBody()?['prazo']), '/'))), triggerBody()?['prazo'], concat(last(split(string(triggerBody()?['prazo']), '/')), '-', if(equals(length(first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), 1), concat('0', first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), first(skip(split(string(triggerBody()?['prazo']), '/'), 1))), '-', if(equals(length(first(split(string(triggerBody()?['prazo']), '/'))), 1), concat('0', first(split(string(triggerBody()?['prazo']), '/'))), first(split(string(triggerBody()?['prazo']), '/')))))"
        },
        "Compose_ProjectName": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 'projeto='), trim(substring(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], '')), 8, sub(length(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 8))), if(startsWith(toLower(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 'projeto:'), trim(substring(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], '')), 8, sub(length(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 8))), trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))))"
        },
        "Map_Impacto": {
          "runAfter": {
            "Get_Projeto": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'cr'), 'Critico', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'a'), 'Alto', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'm'), 'Medio', if(startsWith(toLower(coalesce(triggerBody()?['impacto'], 'Medio')), 'b'), 'Baixo', 'Medio'))))"
        },
        "Compose_DecisionID": {
          "runAfter": {
            "Compose_Prazo": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@concat('DEC-', toUpper(substring(guid(), 0, 8)))"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
