                                                                                "inputs":  {
                                                                                               "from":  "@body(\u0027Get_Projetos_Ativos\u0027)?[\u0027value\u0027]",
                                                                                               "where":  "@equals(coalesce(item()?[\u0027StatusRAG\u0027]?[\u0027Value\u0027], item()?[\u0027StatusRAG\u0027]), \u0027Verde\u0027)"
