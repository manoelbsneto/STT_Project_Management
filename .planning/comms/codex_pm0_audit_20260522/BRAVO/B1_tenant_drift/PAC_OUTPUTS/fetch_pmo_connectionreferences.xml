      <condition attribute="connectionreferencedisplayname" operator="like" value="%PMO%" />
      <condition attribute="connectionreferencelogicalname" operator="like" value="%DataverseIndexerSharePoint%" />
      <condition attribute="connectionreferencelogicalname" operator="like" value="%sharedplanner_87b5f%" />
      <condition attribute="connectionreferencelogicalname" operator="like" value="%sharedteams_1ef7e%" />
    </filter>
