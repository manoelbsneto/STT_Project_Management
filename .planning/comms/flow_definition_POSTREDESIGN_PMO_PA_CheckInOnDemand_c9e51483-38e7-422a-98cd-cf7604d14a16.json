itCheckIn\",\"projectId\":\"${ProjectID}\",\"cardVersion\":\"1.0\",\"origemEntrada\":\"AdaptiveCard\"}}]}\u0027, \u0027${ProjectName}\u0027, coalesce(first(body(\u0027Get_Projeto\u0027)?[\u0027value\u0027])?[\u0027NomeProjeto\u0027], first(body(\u0027Get_Projeto\u0027)?[\u0027value\u0027])?[\u0027Title\u0027], triggerBody()?[\u0027ProjectID\u0027])), \u0027${ProjectID}\u0027, triggerBody()?[\u0027ProjectID\u0027])",
