{
  "timestamp": "2026-05-10T20:18:13.6254556-03:00",
  "status": "BUILD_ONLY",
  "displayName": "PMO_PA_ConsultarPortfolio",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "Copilot_Request": {
        "type": "Request",
        "kind": "Skills",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "includeDeleted": {
                "type": "string",
                "description": "Incluir registros excluidos? sim/nao"
              }
            },
            "required": []
          }
        }
      }
    },
    "actions": {
      "Get_Projetos_Ativos": {
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "$filter": "@{if(or(equals(toLower(string(triggerBody()?['includeDeleted'])), 'sim'), equals(toLower(string(triggerBody()?['includeDeleted'])), 'true'), equals(toLower(string(triggerBody()?['includeDeleted'])), 'yes')), 'Ativo eq 1', 'Ativo eq 1 and Deleted eq 0')}",
            "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
            "table": "Projetos",
            "$top": 500
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "operationId": "GetItems",
            "connectionName": "shared_sharepointonline"
          },
          "authentication": "@parameters('$authentication')"
        },
        "runAfter": {}
      },
      "Initialize_Vermelho": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varVermelho",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Initialize_Amarelo": [
            "Succeeded"
          ]
        }
      },
      "Response_OK": {
        "type": "Response",
        "kind": "Skills",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "message": "@{concat('Portfolio PMO: ', string(variables('varTotal')), ' projetos ativos. Verde: ', string(variables('varVerde')), ' | Amarelo: ', string(variables('varAmarelo')), ' | Vermelho: ', string(variables('varVermelho')), '. Projetos sem update (>24h): ', string(variables('varSemUpdate')), '.')}"
          }
        },
        "runAfter": {
          "Apply_to_each_Projeto": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Total": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varTotal",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Get_Projetos_Ativos": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Amarelo": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varAmarelo",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Initialize_Verde": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Verde": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varVerde",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Initialize_Total": [
            "Succeeded"
          ]
        }
      },
      "Apply_to_each_Projeto": {
        "type": "Foreach",
        "foreach": "@body('Get_Projetos_Ativos')?['value']",
        "actions": {
          "Increment_Total": {
            "type": "IncrementVariable",
            "inputs": {
              "name": "varTotal",
              "value": 1
            },
            "runAfter": {}
          },
          "Switch_StatusRAG": {
            "type": "Switch",
            "expression": "@coalesce(item()?['StatusRAG']?['Value'], item()?['StatusRAG'], '')",
            "cases": {
              "Verde": {
                "case": "Verde",
                "actions": {
                  "Increment_Verde": {
                    "type": "IncrementVariable",
                    "inputs": {
                      "name": "varVerde",
                      "value": 1
                    },
                    "runAfter": {}
                  }
                }
              },
              "Amarelo": {
                "case": "Amarelo",
                "actions": {
                  "Increment_Amarelo": {
                    "type": "IncrementVariable",
                    "inputs": {
                      "name": "varAmarelo",
                      "value": 1
                    },
                    "runAfter": {}
                  }
                }
              },
              "Vermelho": {
                "case": "Vermelho",
                "actions": {
                  "Increment_Vermelho": {
                    "type": "IncrementVariable",
                    "inputs": {
                      "name": "varVermelho",
                      "value": 1
                    },
                    "runAfter": {}
                  }
                }
              }
            },
            "default": {
              "actions": {}
            },
            "runAfter": {
              "Increment_Total": [
                "Succeeded"
              ]
            }
          },
          "Condition_Sem_Update": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@item()?['UltimaAtualizacao']",
                      null
                    ]
                  }
                },
                {
                  "less": [
                    "@ticks(item()?['UltimaAtualizacao'])",
                    "@ticks(addDays(utcNow(), -1))"
                  ]
                }
              ]
            },
            "actions": {
              "Increment_SemUpdate": {
                "type": "IncrementVariable",
                "inputs": {
                  "name": "varSemUpdate",
                  "value": 1
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Switch_StatusRAG": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_SemUpdate": [
            "Succeeded"
          ]
        }
      },
      "Initialize_SemUpdate": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varSemUpdate",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Initialize_Vermelho": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "triggerType": "Request/Skills",
  "connectors": [
    "shared_sharepointonline"
  ],
  "standardOnly": true
}
