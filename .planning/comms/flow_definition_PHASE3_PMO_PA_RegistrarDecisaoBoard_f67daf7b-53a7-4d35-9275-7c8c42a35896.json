                                                                                               "poster":  "Flow bot",
                                                                                               "body/body/updateMessage":  "Resposta registrada no Hub PMO.",
                                                                                               "body/body/messageBody":  "@replace(replace(replace(replace(replace(replace(\u0027{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"Image\",\"url\":\"https://img.icons8.com/fluency/48/approval.png\",\"size\":\"Small\"}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"ðŸ“‹ DecisÃ£o Pendente\",\"weight\":\"Bolder\",\"size\":\"Medium\"},{\"type\":\"TextBlock\",\"text\":\"Uma decisÃ£o requer sua aprovaÃ§Ã£o\",\"isSubtle\":true,\"spacing\":\"None\"}]}]},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Decision ID:\",\"value\":\"${DecisionID}\"},{\"title\":\"Projeto:\",\"value\":\"${ProjectName}\"},{\"title\":\"Solicitante:\",\"value\":\"${Solicitante}\"},{\"title\":\"Prazo:\",\"value\":\"${Prazo}\"},{\"title\":\"Impacto:\",\"value\":\"${Impacto}\"}]},{\"type\":\"TextBlock\",\"text\":\"ðŸ“ **DescriÃ§Ã£o:**\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${Descricao}\",\"wrap\":true},{\"type\":\"Input.Text\",\"id\":\"justificativa\",\"label\":\"ðŸ’¬ Justificativa (obrigatÃ³ria para rejeiÃ§Ã£o/adiamento)\",\"isMultiline\":true,\"placeholder\":\"Adicione sua justificativa...\"}],\"actions\":[{\"type\":\"Action.Submit\",\"title\":\"âœ… Aprovar\",\"style\":\"positive\",\"data\":{\"action\":\"approveDecision\",\"decisionId\":\"${DecisionID}\",\"resposta\":\"Aprovada\",\"cardVersion\":\"1.0\"}},{\"type\":\"Action.Submit\",\"title\":\"âŒ Rejeitar\",\"style\":\"destructive\",\"data\":{\"action\":\"rejectDecision\",\"decisionId\":\"${DecisionID}\",\"resposta\":\"Rejeitada\",\"cardVersion\":\"1.0\"}},{\"type\":\"Action.Submit\",\"title\":\"â¸ï¸ Adiar\",\"data\":{\"action\":\"deferDecision\",\"decisionId\":\"${DecisionID}\",\"resposta\":\"Adiada\",\"cardVersion\":\"1.0\"}}]}\u0027, \u0027${DecisionID}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027DecisionID\u0027], triggerBody()?[\u0027DecisionID\u0027], \u0027-\u0027)), \u0027${ProjectName}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027ProjectID\u0027], triggerBody()?[\u0027ProjectID\u0027], \u0027-\u0027)), \u0027${Solicitante}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Solicitante\u0027]?[\u0027DisplayName\u0027], body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Solicitante\u0027]?[\u0027Email\u0027], \u0027-\u0027)), \u0027${Prazo}\u0027, coalesce(string(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Prazo\u0027]), \u0027-\u0027)), \u0027${Impacto}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Impacto\u0027]?[\u0027Value\u0027], body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Impacto\u0027], \u0027-\u0027)), \u0027${Descricao}\u0027, coalesce(body(\u0027Get_Decisao_Detalhes\u0027)?[\u0027Descricao\u0027], \u0027-\u0027))",
                                                                                               "location":  "Channel"
                                                                                           },
                                                                            "host":  {
