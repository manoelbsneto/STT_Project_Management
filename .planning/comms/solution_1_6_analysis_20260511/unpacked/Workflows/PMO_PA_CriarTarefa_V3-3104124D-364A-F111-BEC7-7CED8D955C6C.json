{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "gstf_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "b8f61c18-7224-4f8a-9c5f-72fbce5df764"
          },
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "description": "nomeProjeto",
                  "title": "Texto",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "description": "titulo",
                  "title": "Texto 1",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "description": "responsavel",
                  "title": "Texto 2",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_3": {
                  "description": "prazo",
                  "title": "Texto 3",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "number": {
                  "description": "horas",
                  "title": "Numero",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "text_4": {
                  "description": "prioridade",
                  "title": "Texto 4",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
                "text_3",
                "number",
                "text_4"
              ]
            }
          }
        }
      },
      "actions": {
        "Compose_NomeProjeto": {
          "runAfter": {
            "Initialize_ResponseMessage": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "3041ca54-483b-471b-9755-3e7118814243"
          },
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerBody()?['text'], triggerBody()?['text_1'], 'Sem nome'))"
        },
        "Compose_DataAlvo": {
          "runAfter": {
            "Compose_NomeProjeto": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ea1511f0-ce6b-4bd9-9567-8b6de15cd4bd"
          },
          "type": "Compose",
          "inputs": "@if(contains(string(triggerBody()?['text_3']), '/'), if(equals(length(first(split(string(triggerBody()?['text_3']), '/'))), 4), replace(string(triggerBody()?['text_3']), '/', '-'), concat(last(split(string(triggerBody()?['text_3']), '/')), '-', if(equals(length(first(skip(split(string(triggerBody()?['text_3']), '/'), 1))), 1), concat('0', first(skip(split(string(triggerBody()?['text_3']), '/'), 1))), first(skip(split(string(triggerBody()?['text_3']), '/'), 1))), '-', if(equals(length(first(split(string(triggerBody()?['text_3']), '/'))), 1), concat('0', first(split(string(triggerBody()?['text_3']), '/'))), first(split(string(triggerBody()?['text_3']), '/'))))), string(triggerBody()?['text_3']))"
        },
        "Map_Prioridade": {
          "runAfter": {
            "Compose_DataAlvo": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "596a088a-f478-4c40-ac00-bbe33fbe7b52"
          },
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(trim(coalesce(triggerBody()?['text_4'], 'Media'))), 'cr'), 'Critica', if(startsWith(toLower(trim(coalesce(triggerBody()?['text_4'], 'Media'))), 'al'), 'Alta', if(startsWith(toLower(trim(coalesce(triggerBody()?['text_4'], 'Media'))), 'ba'), 'Baixa', 'Media')))"
        },
        "Compose_ProjectID": {
          "runAfter": {
            "Map_Prioridade": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "92f3d1fb-ee0e-4946-bd0a-0fb77c81f991"
          },
          "type": "Compose",
          "inputs": "@concat('PRJ-', toUpper(substring(guid(), 0, 8)))"
        },
        "Get_Duplicate_Projects": {
          "runAfter": {
            "Compose_ProjectID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c2ee3269-008c-4b00-9d37-8b3ca081adf5"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "0271c9e8-c184-4b91-99f9-5b71f9b08826",
              "$filter": "NomeProjeto eq '@{replace(outputs('Compose_NomeProjeto'), '''', '''''')}' and DataAlvo ge datetime'@{outputs('Compose_DataAlvo')}T00:00:00Z' and DataAlvo lt datetime'@{formatDateTime(addDays(outputs('Compose_DataAlvo'), 1), 'yyyy-MM-dd')}T00:00:00Z' and Deleted ne 1",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Filtro por NomeProjeto, DataAlvo em intervalo diario e Deleted ne 1 para compatibilidade OData do SharePoint."
        },
        "Condition_Duplicate_Projeto": {
          "actions": {
            "Create_Projeto_SharePoint": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "624f5467-198c-42ae-a674-d4d43a283321"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "table": "0271c9e8-c184-4b91-99f9-5b71f9b08826",
                  "item/Title": "@outputs('Compose_NomeProjeto')",
                  "item/ProjectID": "@outputs('Compose_ProjectID')",
                  "item/NomeProjeto": "@outputs('Compose_NomeProjeto')",
                  "item/StatusRAG/Value": "Verde",
                  "item/Percentual": 0,
                  "item/DataAlvo": "@outputs('Compose_DataAlvo')",
                  "item/Ativo": true,
                  "item/PM/Claims": "@concat('i:0#.f|membership|', if(contains(coalesce(triggerBody()?['text_2'], ''), '@'), triggerBody()?['text_2'], 'mbenicios@minsait.com'))",
                  "item/UltimaAtualizacao": "@utcNow()",
                  "item/Prioridade/Value": "@outputs('Map_Prioridade')",
                  "item/ResumoExecutivo": "@concat('Projeto criado via Copilot Studio. Titulo: ', coalesce(triggerBody()?['text_1'], '-'), '. Horas estimadas: ', coalesce(string(triggerBody()?['number']), 'N/A'), 'h. Responsavel: ', coalesce(triggerBody()?['text_2'], '-'), '. Prazo: ', coalesce(triggerBody()?['text_3'], '-'), '.')",
                  "item/Deleted": false
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_Response_Success": {
              "runAfter": {
                "Create_Projeto_SharePoint": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "5622545a-abde-4d4c-9e3f-972533f5734f"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "responseMessage",
                "value": "Projeto criado com sucesso!"
              }
            }
          },
          "runAfter": {
            "Get_Duplicate_Projects": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Response_Duplicate": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "3be08b3f-fc5f-44fc-9e65-155b8d9412d1"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "responseMessage",
                  "value": "Ja existe um projeto com o nome especificado. Nenhum item duplicado foi criado."
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@empty(outputs('Get_Duplicate_Projects')?['body/value'])",
              "@true"
            ]
          },
          "metadata": {
            "operationMetadataId": "fb212019-2413-43c5-9170-fbbf74ff8b52"
          },
          "type": "If"
        },
        "Initialize_ResponseMessage": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "d2833a09-12e9-4d87-99ef-7451429f60ef"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "responseMessage",
                "type": "string"
              }
            ]
          }
        },
        "Valores_retornados_para_o_Power_Virtual_Agents": {
          "runAfter": {
            "Condition_Duplicate_Projeto": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "36fe9d96-7935-4008-96a2-9a6096b8c6ee"
          },
          "type": "Response",
          "kind": "VirtualAgent",
          "inputs": {
            "statusCode": 200,
            "body": {
              "message": "@variables('responseMessage')"
            },
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}