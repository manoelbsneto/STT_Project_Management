                                                                                                                                                                               "poster":  "Flow bot",
                                                                                                                                                                               "body/messageBody":  "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(\u0027{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"Container\",\"style\":\"attention\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"RISCO CRITICO ESCALADO\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"color\":\"Attention\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"Acao executiva necessaria\",\"isSubtle\":true,\"spacing\":\"None\",\"wrap\":true}]},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Risk ID:\",\"value\":\"${RiskID}\"},{\"title\":\"Projeto:\",\"value\":\"${ProjectID}\"},{\"title\":\"Nome:\",\"value\":\"${ProjectName}\"},{\"title\":\"Tipo:\",\"value\":\"${Tipo}\"},{\"title\":\"Severidade:\",\"value\":\"${Severidade}\"},{\"title\":\"Impacto:\",\"value\":\"${Impacto}\"},{\"title\":\"Owner:\",\"value\":\"${Owner}\"},{\"title\":\"SLA:\",\"value\":\"${SLA}\"}]},{\"type\":\"TextBlock\",\"text\":\"Descricao\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${Descricao}\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"Plano de mitigacao\",\"weight\":\"Bolder\",\"spacing\":\"Medium\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"${PlanoMitigacao}\",\"wrap\":true}],\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"Abrir riscos no SharePoint\",\"url\":\"${RiskListUrl}\"}]}\u0027, \u0027${RiskID}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027RiskID\u0027], triggerBody()?[\u0027RiskID\u0027], \u0027-\u0027)), \u0027${ProjectID}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027ProjectID\u0027], triggerBody()?[\u0027ProjectID\u0027], \u0027-\u0027)), \u0027${ProjectName}\u0027, coalesce(first(body(\u0027Get_Projeto\u0027)?[\u0027value\u0027])?[\u0027NomeProjeto\u0027], first(body(\u0027Get_Projeto\u0027)?[\u0027value\u0027])?[\u0027Title\u0027], \u0027-\u0027)), \u0027${Tipo}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Tipo\u0027]?[\u0027Value\u0027], body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Tipo\u0027], \u0027-\u0027)), \u0027${Severidade}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Severidade\u0027]?[\u0027Value\u0027], body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Severidade\u0027], \u0027-\u0027)), \u0027${Impacto}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Impacto\u0027]?[\u0027Value\u0027], body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Impacto\u0027], \u0027-\u0027)), \u0027${Owner}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Owner\u0027]?[\u0027DisplayName\u0027], body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Owner\u0027]?[\u0027Email\u0027], \u0027-\u0027)), \u0027${SLA}\u0027, coalesce(string(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027SLA\u0027]), \u0027-\u0027)), \u0027${Descricao}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027Descricao\u0027], \u0027-\u0027)), \u0027${PlanoMitigacao}\u0027, coalesce(body(\u0027Get_Risco_Detalhes\u0027)?[\u0027PlanoMitigacao\u0027], \u0027Nao informado\u0027)), \u0027${RiskListUrl}\u0027, \u0027https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital/Lists/Riscos%20e%20Bloqueios/AllItems.aspx\u0027)",
