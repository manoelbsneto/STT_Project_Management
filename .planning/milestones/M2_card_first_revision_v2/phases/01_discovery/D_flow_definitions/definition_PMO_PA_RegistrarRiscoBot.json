{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pmo_sharedsharepointonline_6e373"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "severidade": {
                  "type": "string",
                  "description": "Severidade",
                  "title": "severidade",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "projectName": {
                  "type": "string",
                  "description": "Nome do projeto",
                  "title": "projectName",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "descricao": {
                  "type": "string",
                  "description": "Descricao do risco",
                  "title": "descricao",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "impacto": {
                  "type": "string",
                  "description": "Impacto",
                  "title": "impacto",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "projectName",
                "descricao",
                "severidade"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "1ec4ecad-b082-4de7-afae-85ea4caab45c"
          }
        }
      },
      "actions": {
        "Compose_RiskID": {
          "runAfter": {
            "Map_Severidade": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@concat('RISK-', toUpper(substring(guid(), 0, 8)))"
        },
        "Compose_ProjectName": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 'projeto='), trim(substring(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], '')), 8, sub(length(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 8))), if(startsWith(toLower(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 'projeto:'), trim(substring(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], '')), 8, sub(length(trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))), 8))), trim(coalesce(triggerBody()?['projectName'], triggerBody()?['projectName'], triggerBody()?['nomeProjeto'], ''))))"
        },
        "Map_Severidade": {
          "runAfter": {
            "Get_Projeto": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(startsWith(toLower(coalesce(triggerBody()?['severidade'], 'Media')), 'cr'), 'Critica', if(startsWith(toLower(coalesce(triggerBody()?['severidade'], 'Media')), 'a'), 'Alta', if(startsWith(toLower(coalesce(triggerBody()?['severidade'], 'Media')), 'b'), 'Baixa', 'Media')))"
        },
        "Condition_Projeto_Encontrado": {
          "actions": {
            "Create_Risco_SharePoint": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "item/DataCriacao": "@utcNow()",
                  "item/StatusRisco/Value": "Aberto",
                  "item/Severidade/Value": "@outputs('Map_Severidade')",
                  "item/Deleted": false,
                  "item/RiskID": "@outputs('Compose_RiskID')",
                  "table": "Riscos e Bloqueios",
                  "item/Descricao": "@triggerBody()?['descricao']",
                  "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
                  "item/ProjectID": "@body('Get_Projeto')?['value']?[0]?['ProjectID']",
                  "item/Tipo/Value": "Risco",
                  "item/Title": "@outputs('Compose_RiskID')",
                  "item/Impacto/Value": "@triggerBody()?['impacto']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Response_OK": {
              "runAfter": {
                "Create_Risco_SharePoint": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "@{concat('Risco ', outputs('Compose_RiskID'), ' registrado para projeto ', outputs('Compose_ProjectName'), '. Severidade: ', outputs('Map_Severidade'), '.')}"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            },
            "Response_Error_Write": {
              "runAfter": {
                "Create_Risco_SharePoint": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Response",
              "kind": "Skills",
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "message": "Erro ao registrar risco no SharePoint. Codigo: SP_WRITE_FAILED."
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Compose_RiskID": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Response_Project_Not_Found": {
                "runAfter": {},
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "message": "Projeto nao encontrado. Codigo: PROJECT_NOT_FOUND."
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "title": "message",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "expression": {
            "greater": [
              "@length(body('Get_Projeto')?['value'])",
              0
            ]
          },
          "type": "If"
        },
        "Get_Projeto": {
          "runAfter": {
            "Compose_ProjectName": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "$filter": "NomeProjeto eq '@{replace(outputs('Compose_ProjectName'),'''','''''')}' and Ativo eq 1 and Deleted eq 0",
              "$top": 1,
              "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital",
              "table": "Projetos"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
