{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Skills",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "description": "Action"
            },
            "projectId": {
              "type": "string",
              "description": "Project ID"
            }
          },
          "required": [
            "projectId",
            "action"
          ]
        }
      }
    }
  },
  "actions": {
    "List_Planner_Tasks": {
      "runAfter": {
        "Get_Tarefas": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "id": "-1kBj1PLv0qQM-R4PwkqbpcABv_P",
          "groupId": "96c5b0c4-46cc-46cd-8695-50451db74994"
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_planner",
          "connectionName": "shared_planner",
          "operationId": "ListTasks_V3"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Respond_Success": {
      "runAfter": {
        "Normalize_Tasks": [
          "Succeeded"
        ]
      },
      "type": "Response",
      "kind": "Skills",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "result": "Tasks retrieved successfully."
        },
        "schema": {
          "type": "object",
          "properties": {
            "result": {
              "title": "result",
              "x-ms-dynamically-added": true,
              "type": "string"
            }
          }
        }
      }
    },
    "Normalize_Tasks": {
      "runAfter": {
        "List_Planner_Tasks": [
          "Succeeded"
        ]
      },
      "type": "Select",
      "inputs": {
        "from": "@body('Get_Tarefas')?['value']",
        "select": {
          "plannerBucketId": "@item()?['PlannerBucketId']",
          "plannerTaskId": "@item()?['PlannerTaskId']",
          "title": "@item()?['Title']",
          "projectId": "@item()?['ProjectID']",
          "status": "@coalesce(item()?['Status']?['Value'], item()?['Status'])"
        }
      }
    },
    "Get_Tarefas": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "$filter": "ProjectID eq '@{replace(triggerBody()?['projectId'],'''','''''')}'",
          "table": "Tarefas",
          "$top": 100,
          "dataset": "https://indra365.sharepoint.com/sites/Grp_T_DN_Transformacao_Digital"
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    }
  },
  "outputs": {}
}
