    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Skills",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "description": "Action"
            },
            "status": {
              "type": "string",
