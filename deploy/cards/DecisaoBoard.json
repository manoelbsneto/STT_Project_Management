{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [{ "type": "Image", "url": "https://img.icons8.com/fluency/48/approval.png", "size": "Small" }]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "📋 Decisão Pendente", "weight": "Bolder", "size": "Medium" },
            { "type": "TextBlock", "text": "Uma decisão requer sua aprovação", "isSubtle": true, "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Decision ID:", "value": "${DecisionID}" },
        { "title": "Projeto:", "value": "${ProjectName}" },
        { "title": "Solicitante:", "value": "${Solicitante}" },
        { "title": "Prazo:", "value": "${Prazo}" },
        { "title": "Impacto:", "value": "${Impacto}" }
      ]
    },
    { "type": "TextBlock", "text": "📝 **Descrição:**", "wrap": true },
    { "type": "TextBlock", "text": "${Descricao}", "wrap": true },
    {
      "type": "Input.Text",
      "id": "justificativa",
      "label": "💬 Justificativa (obrigatória para rejeição/adiamento)",
      "isMultiline": true,
      "placeholder": "Adicione sua justificativa..."
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "✅ Aprovar",
      "style": "positive",
      "data": { "action": "approveDecision", "decisionId": "${DecisionID}", "resposta": "Aprovada", "cardVersion": "1.0" }
    },
    {
      "type": "Action.Submit",
      "title": "❌ Rejeitar",
      "style": "destructive",
      "data": { "action": "rejectDecision", "decisionId": "${DecisionID}", "resposta": "Rejeitada", "cardVersion": "1.0" }
    },
    {
      "type": "Action.Submit",
      "title": "⏸️ Adiar",
      "data": { "action": "deferDecision", "decisionId": "${DecisionID}", "resposta": "Adiada", "cardVersion": "1.0" }
    }
  ]
}
