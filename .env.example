# === CONFIGURAÇÃO DE AMBIENTE DO CODESPACES ===
# Copie este arquivo para .env (ou use os Secrets do GitHub Codespaces)
# NUNCA commit o arquivo .env real no repositório!

# -------------------------------------------------
# 1. OPENAI / AIDER (OBRIGATÓRIO para Aider + Codex)
# -------------------------------------------------
# Secret do GitHub: OPENAI_API_KEY
# Onde pegar: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Modelo principal do Aider (opcional, padrão: gpt-4o)
# Secret do GitHub: AIDER_MODEL
AIDER_MODEL=gpt-4o

# Modelo "weak" para tarefas simples do Aider (opcional)
# Secret do GitHub: AIDER_WEAK_MODEL
AIDER_WEAK_MODEL=gpt-4o-mini

# -------------------------------------------------
# 2. GOOGLE CLOUD / VERTEX AI (OBRIGATÓRIO para Gemini)
# -------------------------------------------------
# Secret do GitHub: GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_PROJECT=vertex-teste-493622

# Secret do GitHub: GOOGLE_CLOUD_LOCATION
GOOGLE_CLOUD_LOCATION=global

# Secret do GitHub: GOOGLE_GENAI_USE_VERTEXAI
GOOGLE_GENAI_USE_VERTEXAI=True

# -------------------------------------------------
# 3. ANTHROPIC / CLAUDE (opcional)
# -------------------------------------------------
# Chave da API da Anthropic (se usar Claude diretamente)
# Secret do GitHub: ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Projeto/Região do Anthropic no Vertex AI
# Secret do GitHub: ANTHROPIC_VERTEX_PROJECT_ID
ANTHROPIC_VERTEX_PROJECT_ID=vertex-teste-493622
ANTHROPIC_VERTEX_REGION=global
