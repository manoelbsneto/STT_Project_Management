# .env.local - Local Development Secrets (NEVER commit to Git!)
# Copy to .env.local and fill your values
# This file is already added to .gitignore

# -------------------------------------------------
# LOCAL ONLY: GitHub Personal Access Token
# Used for local SSH connections to GitHub (e.g., git push/pull via SSH)
# and for local GitHub CLI (gh) authentication.
#
# How to generate: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org (adjust as needed)
# -------------------------------------------------
# GITHUB_TOKEN=your_github_token_here

# -------------------------------------------------
# LOCAL ONLY: OpenAI API Key
# Used for Aider and other local AI tools that don't use GitHub Secrets.
# How to get: https://platform.openai.com/api-keys
# -------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------
# LOCAL ONLY: Your GitHub Username
# -------------------------------------------------
# GITHUB_USER=your_github_username
